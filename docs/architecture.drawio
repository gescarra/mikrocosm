    <mxCell id="l_br2_hh" value="&lt;b&gt;eBGP&lt;/b&gt; v4 + v6&lt;br&gt;AS64500 ↔ AS65473&lt;br&gt;TCP-MD5 · multihop" style="edgeLabel;html=1;labelBackgroundColor=#ffffff;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=10;fontFamily=Courier New;spacing=4;" vertex="1" connectable="0" parent="e_br2_hh">
