    <mxCell id="e_bb_r" style="edgeStyle=none;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=3;endArrow=none;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="backbone" target="br2">
