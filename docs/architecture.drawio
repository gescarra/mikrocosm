    <mxCell id="p_ibgp" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1700" y="100" width="960" height="460" as="geometry"/>
    </mxCell>
    <mxCell id="p_ibgp_txt" value="&lt;b style=&quot;font-size:14px&quot;&gt;iBGP — FULL MESH, no route reflector · AS64500&lt;/b&gt;&lt;br&gt;&lt;br&gt;4 routers ⇒ 6 pairs ⇒ &lt;b&gt;6 v4 sessions + 6 v6 sessions = 12&lt;/b&gt;&lt;br&gt;v4 and v6 are SEPARATE sessions, not one session with two AFIs, so&lt;br&gt;nexthop-choice=force-self stays trivially correct (no RFC 5549) and&lt;br&gt;a filter mistake in one family cannot take the other down.&lt;br&gt;&lt;br&gt;peering &amp;nbsp;: &lt;b&gt;loopback ↔ loopback&lt;/b&gt; · multihop=yes · force-self&lt;br&gt;v4 pairs: .241↔.242 · .241↔.249 · .241↔.250&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;.242↔.249 · .242↔.250 · .249↔.250&lt;br&gt;v6 pairs: ::b1↔::b2 · ::b1↔::e1 · ::b1↔::e2&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;::b2↔::e1 · ::b2↔::e2 · ::e1↔::e2&lt;br&gt;&lt;br&gt;&lt;b&gt;BR → ER&lt;/b&gt; : output.default-originate=if-installed&lt;br&gt;&lt;b&gt;BR → BR&lt;/b&gt; : NEVER a default — it would point a BR&#39;s own tunnel-&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; endpoint route back into the tunnel&lt;br&gt;&lt;b&gt;ER → BR&lt;/b&gt; : 203.0.113.0/25 + 2001:DB8:1::/48 only; customer&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; VIP more-specifics stay home&lt;br&gt;&lt;b&gt;ER → ER&lt;/b&gt; : same, except VIP more-specifics ARE permitted&lt;br&gt;&lt;b&gt;all&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; : never leak the aggregate into iBGP — every BR&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; originates it locally&lt;br&gt;&lt;br&gt;&lt;b&gt;large communities&lt;/b&gt;: 64500:1:666 RTBH (explicit, via the rtbh list)&lt;br&gt;64500:1:1xxx origin site tag (1001 hdc · 1002 ord1 · 1003 ord2)&lt;br&gt;64500:2:1|2|3 prepend ×n · 64500:3:&amp;lt;asn&amp;gt; do-not-announce to that AS" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="1716" y="118" width="600" height="440" as="geometry"/>
    </mxCell>
    <mxCell id="mesh_cap" value="&lt;b&gt;the mesh&lt;/b&gt;&lt;br&gt;every pair peers directly" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="2330" y="120" width="310" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="m_br1" value="br1&lt;br&gt;.241 / ::b1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="2330" y="180" width="120" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="m_br2" value="br2&lt;br&gt;.242 / ::b2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="2520" y="180" width="120" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="m_er1" value="er1&lt;br&gt;.249 / ::e1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="2330" y="390" width="120" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="m_er2" value="er2&lt;br&gt;.250 / ::e2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="2520" y="390" width="120" height="48" as="geometry"/>
