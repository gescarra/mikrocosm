<mxfile host="drawio"><diagram name="architecture"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2760" pageHeight="2300" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="&lt;b style=&quot;font-size:22px&quot;&gt;AS64500 — WireGuard · OSPF+BFD · iBGP · eBGP architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;203.0.113.0/24 · 2001:DB8::/40 (ARIN) · example.net · dual-stack throughout · rendered from topology.yml&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="200" y="16" width="1420" height="64" as="geometry"/>
    </mxCell>

    <mxCell id="vultr" value="&lt;b&gt;VULTR — AS64515&lt;/b&gt;&amp;nbsp; upstream / transit&lt;br&gt;&lt;br&gt;eBGP v4 &amp;nbsp;local 198.51.100.57 ↔ remote 169.254.169.254&lt;br&gt;eBGP v6 &amp;nbsp;local 2001:db8:f000:4126:5400:6ff:fe12:3456&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;↔ remote 2001:19f0:ffff::1&lt;br&gt;multihop · TCP-MD5 · listen=yes connect=yes · 2 separate sessions&lt;br&gt;&lt;b&gt;in&lt;/b&gt;&amp;nbsp; : default only (0.0.0.0/0 · ::/0) — filter-nlri drops the full table&lt;br&gt;&lt;b&gt;out&lt;/b&gt;: 203.0.113.0/24 + 2001:DB8::/42 only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="200" y="100" width="520" height="170" as="geometry"/>
    </mxCell>

    <mxCell id="hosthatch" value="&lt;b&gt;HOSTHATCH — AS65473&lt;/b&gt;&amp;nbsp; upstream / transit&lt;br&gt;&lt;br&gt;eBGP v4 &amp;nbsp;local 198.51.100.200 ↔ remote 169.254.169.254&lt;br&gt;eBGP v6 &amp;nbsp;local 2001:db8:f001:a595::179 ↔ remote 2605:4840:ffff::179&lt;br&gt;multihop · TCP-MD5 · listen=yes connect=yes · 2 separate sessions&lt;br&gt;&lt;b&gt;MANDATORY community 65500:10000&lt;/b&gt; — without it the DDoS-scrubbing&lt;br&gt;platform does not propagate the announcement at all&lt;br&gt;&lt;b&gt;in&lt;/b&gt;&amp;nbsp; : default only&amp;nbsp;&amp;nbsp;&lt;b&gt;out&lt;/b&gt;: 203.0.113.0/24 + 2001:DB8::/42" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="1100" y="100" width="520" height="170" as="geometry"/>
    </mxCell>

    <mxCell id="dfz" value="&lt;b&gt;Public Internet / DFZ&lt;/b&gt;&lt;br&gt;&lt;br&gt;also carries the WireGuard&lt;br&gt;&lt;b&gt;underlay&lt;/b&gt;: BR ether1 ↔ ER wan1/wan2" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontFamily=Courier New;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="760" y="100" width="300" height="170" as="geometry"/>
    </mxCell>

    <mxCell id="br1" value="&lt;b&gt;br1.ord1&lt;/b&gt;&amp;nbsp; —&amp;nbsp; br1.ord1.example.net&lt;br&gt;MikroTik CHR · site ord1 (Vultr) · AS64500&lt;br&gt;&lt;br&gt;&lt;b&gt;lo0&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 203.0.113.241 &amp;nbsp;·&amp;nbsp; 2001:db8::b1&lt;br&gt;router-id 203.0.113.241 &amp;nbsp;(BGP + OSPFv2 + OSPFv3)&lt;br&gt;&lt;b&gt;ether1&lt;/b&gt;&amp;nbsp; 198.51.100.57/25 &amp;nbsp;gw 198.51.100.1&lt;br&gt;&lt;b&gt;ether1&lt;/b&gt;&amp;nbsp; 2001:db8:f000:4126:5400:6ff:fe12:3456/64 &amp;nbsp;gw ← RA&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; (EUI-64 from ether1 MAC — pinned to the instance)&lt;br&gt;static default @ distance 30&lt;br&gt;&lt;br&gt;&lt;b&gt;originates&lt;/b&gt; 203.0.113.0/24 + 2001:DB8::/42&lt;br&gt;&amp;nbsp;&amp;nbsp;via the anchor route (blackhole @ distance 254)&lt;br&gt;&lt;b&gt;default-guard&lt;/b&gt;: stops default-originate to the ERs when eBGP&lt;br&gt;&amp;nbsp;&amp;nbsp;drops — gated per-AFI on the SESSION, not on route presence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="200" y="380" width="520" height="270" as="geometry"/>
    </mxCell>

    <mxCell id="br2" value="&lt;b&gt;br2.ord2&lt;/b&gt;&amp;nbsp; —&amp;nbsp; br2.ord2.example.net&lt;br&gt;MikroTik CHR · site ord2 (HostHatch) · AS64500&lt;br&gt;&lt;br&gt;&lt;b&gt;lo0&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 203.0.113.242 &amp;nbsp;·&amp;nbsp; 2001:db8::b2&lt;br&gt;router-id 203.0.113.242 &amp;nbsp;(BGP + OSPFv2 + OSPFv3)&lt;br&gt;&lt;b&gt;ether1&lt;/b&gt;&amp;nbsp; 198.51.100.200/25 &amp;nbsp;gw 198.51.100.129&lt;br&gt;&lt;b&gt;ether1&lt;/b&gt;&amp;nbsp; 2001:db8:f001:a595::179/64 &amp;nbsp;gw fe80::1%ether1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; (fixed link-local gw — must be interface-scoped)&lt;br&gt;static default @ distance 30&lt;br&gt;&lt;br&gt;&lt;b&gt;originates&lt;/b&gt; 203.0.113.0/24 + 2001:DB8::/42&lt;br&gt;&amp;nbsp;&amp;nbsp;via the anchor route (blackhole @ distance 254)&lt;br&gt;&lt;b&gt;default-guard&lt;/b&gt;: v4 and v6 gated independently, so a dead v6&lt;br&gt;&amp;nbsp;&amp;nbsp;session cannot strand v4 (or black-hole v6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="1100" y="380" width="520" height="270" as="geometry"/>
    </mxCell>

    <mxCell id="backbone" value="&lt;b&gt;BACKBONE TUNNEL&lt;/b&gt;&lt;br&gt;wg-br2 (br1) ↔ wg-br1 (br2)&lt;br&gt;&lt;br&gt;203.0.113.160/31&lt;br&gt;&amp;nbsp;&amp;nbsp;br1 .160 · br2 .161&lt;br&gt;2001:db8:0:10::/127&lt;br&gt;&amp;nbsp;&amp;nbsp;br1 ::0 · br2 ::1&lt;br&gt;&lt;br&gt;UDP 51102 ↔ 51101&lt;br&gt;MTU 1360 · PSK · keepalive 25s&lt;br&gt;&lt;br&gt;OSPF ptp cost 5 · 5s / 20s&lt;br&gt;BFD 200ms × 3 → ~600ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="760" y="410" width="300" height="210" as="geometry"/>
    </mxCell>

    <mxCell id="er1" value="&lt;b&gt;er1.hdc&lt;/b&gt;&amp;nbsp; —&amp;nbsp; er1.hdc.example.net&lt;br&gt;MikroTik · site hdc · AS64500&lt;br&gt;&lt;br&gt;&lt;b&gt;lo0&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 203.0.113.249 &amp;nbsp;·&amp;nbsp; 2001:db8::e1&lt;br&gt;router-id 203.0.113.249 &amp;nbsp;(BGP + OSPFv2 + OSPFv3)&lt;br&gt;&lt;b&gt;wan1 ether1&lt;/b&gt;&amp;nbsp; 192.0.2.186/28 gw 192.0.2.190 — fibre, cost 10&lt;br&gt;&lt;b&gt;wan2 ether2&lt;/b&gt;&amp;nbsp; DHCP, CGNAT 5G — no fixed addr, cost 100&lt;br&gt;&lt;b&gt;ether3&lt;/b&gt;&amp;nbsp; xc&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 203.0.113.224/31 · 2001:db8:0:40::/127&lt;br&gt;&lt;b&gt;ether4&lt;/b&gt;&amp;nbsp; transit 203.0.113.233/29 · 2001:DB8:0:41::1/64&lt;br&gt;&lt;br&gt;egress pinning: routing-table &lt;b&gt;via-wan1&lt;/b&gt; (UDP dst 51820-51829)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;via-wan2&lt;/b&gt; (UDP dst 51920-51929)&lt;br&gt;&lt;b&gt;originates&lt;/b&gt; 203.0.113.0/25 + 2001:DB8:1::/48&lt;br&gt;&amp;nbsp;&amp;nbsp;— only while a customer VIP is actually being advertised&lt;br&gt;mgmt SSH from 192.0.2.176/28 · user netops (keys from keys_url)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="200" y="1150" width="520" height="340" as="geometry"/>
    </mxCell>

    <mxCell id="er2" value="&lt;b&gt;er2.hdc&lt;/b&gt;&amp;nbsp; —&amp;nbsp; er2.hdc.example.net&lt;br&gt;MikroTik · site hdc · AS64500&lt;br&gt;&lt;br&gt;&lt;b&gt;lo0&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 203.0.113.250 &amp;nbsp;·&amp;nbsp; 2001:db8::e2&lt;br&gt;router-id 203.0.113.250 &amp;nbsp;(BGP + OSPFv2 + OSPFv3)&lt;br&gt;&lt;b&gt;wan1 ether1&lt;/b&gt;&amp;nbsp; 192.0.2.187/28 gw 192.0.2.190 — fibre, cost 10&lt;br&gt;&lt;b&gt;wan2 ether2&lt;/b&gt;&amp;nbsp; DHCP, CGNAT 5G — no fixed addr, cost 100&lt;br&gt;&lt;b&gt;ether3&lt;/b&gt;&amp;nbsp; xc&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 203.0.113.225/31 · 2001:db8:0:40::1/127&lt;br&gt;&lt;b&gt;ether4&lt;/b&gt;&amp;nbsp; transit 203.0.113.234/29 · 2001:DB8:0:41::2/64&lt;br&gt;&lt;br&gt;egress pinning: routing-table &lt;b&gt;via-wan1&lt;/b&gt; (UDP dst 51820-51829)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;via-wan2&lt;/b&gt; (UDP dst 51920-51929)&lt;br&gt;&lt;b&gt;originates&lt;/b&gt; 203.0.113.0/25 + 2001:DB8:1::/48&lt;br&gt;&amp;nbsp;&amp;nbsp;— identical config; the two ERs are deliberately symmetric&lt;br&gt;NOTE: today wan2 is wired to a dummy router — all four ER&lt;br&gt;&amp;nbsp;&amp;nbsp;tunnels currently share the wan1 underlay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="1100" y="1150" width="520" height="340" as="geometry"/>
    </mxCell>

    <mxCell id="xc" value="&lt;b&gt;ER ↔ ER INTERCONNECT&lt;/b&gt;&lt;br&gt;ether3 — wired Ethernet, one rack&lt;br&gt;&lt;b&gt;no WireGuard&lt;/b&gt;&lt;br&gt;&lt;br&gt;203.0.113.224/31&lt;br&gt;&amp;nbsp;&amp;nbsp;er1 .224 · er2 .225&lt;br&gt;2001:db8:0:40::/127&lt;br&gt;&lt;br&gt;OSPF ptp cost 1 · default 40s&lt;br&gt;BFD 100ms × 3 → ~300ms&lt;br&gt;&lt;br&gt;BFD is here for the failure that&lt;br&gt;does NOT drop carrier — a live-&lt;br&gt;but-not-forwarding sibling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="760" y="1220" width="300" height="200" as="geometry"/>
    </mxCell>

    <mxCell id="transit" value="&lt;b&gt;hdc CUSTOMER TRANSIT SEGMENT&lt;/b&gt; — shared L2 on ether4 of BOTH ERs · no VRRP&lt;br&gt;&lt;br&gt;&lt;b&gt;203.0.113.232/29&lt;/b&gt; — er1 .233 · er2 .234 · fwa .236 · fwb .237&lt;br&gt;&lt;b&gt;2001:DB8:0:41::/64&lt;/b&gt; — er1 ::1 · er2 ::2 · fwa ::10 · fwb ::11 &amp;nbsp;(a real /64: shared L2 with multiple firewalls, not a P2P link)&lt;br&gt;OSPF &lt;b&gt;passive&lt;/b&gt; on ether4 — customers are never OSPF neighbours, an adjacency would hand them the internal topology&lt;br&gt;BFD &lt;b&gt;forbid-bfd=yes&lt;/b&gt; on ether4 — the one place inside the AS where untrusted speakers live&lt;br&gt;Every firewall runs eBGP with &lt;b&gt;both&lt;/b&gt; ERs over this segment: 4 v4 + 4 v6 sessions total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="200" y="1580" width="1420" height="150" as="geometry"/>
    </mxCell>

    <mxCell id="fwa" value="&lt;b&gt;fwa.hdc — pfSense&lt;/b&gt;&lt;br&gt;&lt;b&gt;AS65010&lt;/b&gt; (private) · fwa.hdc.example.net&lt;br&gt;&lt;br&gt;203.0.113.236 &amp;nbsp;·&amp;nbsp; 2001:DB8:0:41::10&lt;br&gt;&lt;br&gt;eBGP&amp;nbsp; → er1 203.0.113.233 &lt;b&gt;and&lt;/b&gt; er2 203.0.113.234&lt;br&gt;eBGP6 → er1 2001:DB8:0:41::1 &lt;b&gt;and&lt;/b&gt; er2 ::2&lt;br&gt;local.role = ebgp-customer&lt;br&gt;&lt;br&gt;&lt;b&gt;GRANT&lt;/b&gt; delegation 203.0.113.0/28 up to /32&lt;br&gt;&lt;b&gt;GRANT&lt;/b&gt; delegation 2001:DB8:1:100::/56 up to /64&lt;br&gt;&amp;nbsp;&amp;nbsp;(256 × /64 LANs for fwa to carve up)&lt;br&gt;&lt;b&gt;receives&lt;/b&gt;: 0.0.0.0/0 and ::/0 ONLY&lt;br&gt;&amp;nbsp;&amp;nbsp;→ ECMP egress across er1 + er2 (replaces VRRP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="200" y="1810" width="520" height="262" as="geometry"/>
    </mxCell>

    <mxCell id="fwb" value="&lt;b&gt;fwb.hdc — pfSense&lt;/b&gt;&lt;br&gt;&lt;b&gt;AS65011&lt;/b&gt; (private) · fwb.hdc.example.net&lt;br&gt;&lt;br&gt;203.0.113.237 &amp;nbsp;·&amp;nbsp; 2001:DB8:0:41::11&lt;br&gt;&lt;br&gt;eBGP&amp;nbsp; → er1 203.0.113.233 &lt;b&gt;and&lt;/b&gt; er2 203.0.113.234&lt;br&gt;eBGP6 → er1 2001:DB8:0:41::1 &lt;b&gt;and&lt;/b&gt; er2 ::2&lt;br&gt;local.role = ebgp-customer&lt;br&gt;&lt;br&gt;&lt;b&gt;GRANT&lt;/b&gt; vip 203.0.113.16/32&lt;br&gt;&lt;b&gt;GRANT&lt;/b&gt; vip 2001:DB8:1::16/128&lt;br&gt;&lt;br&gt;&lt;b&gt;receives&lt;/b&gt;: default only → ECMP egress across er1 + er2&lt;br&gt;two firewalls advertising the same VIP at equal&lt;br&gt;local-pref ⇒ inbound ECMP; set distinct local_pref&lt;br&gt;instead for deterministic primary/backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="1100" y="1810" width="520" height="262" as="geometry"/>
    </mxCell>

    <mxCell id="custsess" value="&lt;b&gt;eBGP CUSTOMER POLICY&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 sessions = 2 fw × 2 ER × 2 AFI&lt;br&gt;&lt;br&gt;&lt;b&gt;inbound&lt;/b&gt; is the security boundary:&lt;br&gt;one accept rule per grant, then a&lt;br&gt;terminal &lt;b&gt;reject&lt;/b&gt;. A firewall gets&lt;br&gt;exactly what topology.yml grants&lt;br&gt;it and nothing else.&lt;br&gt;&lt;br&gt;&lt;b&gt;outbound&lt;/b&gt; (cust-out / cust6-out):&lt;br&gt;accept 0.0.0.0/0 · ::/0, reject all&lt;br&gt;→ no internal prefix can ever leak&lt;br&gt;&amp;nbsp;&amp;nbsp; to a customer&lt;br&gt;&lt;br&gt;The live VIP advertisement is the&lt;br&gt;ONLY health signal for the /25 —&lt;br&gt;real reachability, not a ping." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="760" y="1810" width="300" height="262" as="geometry"/>
    </mxCell>

    <mxCell id="e_br1_vultr" style="edgeStyle=none;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=3;endArrow=none;startArrow=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="br1" target="vultr">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="l_br1_vultr" value="&lt;b&gt;eBGP&lt;/b&gt; v4 + v6&lt;br&gt;AS64500 ↔ AS64515&lt;br&gt;TCP-MD5 · multihop" style="edgeLabel;html=1;labelBackgroundColor=#ffffff;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=10;fontFamily=Courier New;spacing=4;" vertex="1" connectable="0" parent="e_br1_vultr">
