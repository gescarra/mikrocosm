    <mxCell id="e_vultr_dfz" style="edgeStyle=none;html=1;rounded=0;dashed=1;strokeColor=#999999;strokeWidth=2;endArrow=none;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vultr" target="dfz">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_hh_dfz" style="edgeStyle=none;html=1;rounded=0;dashed=1;strokeColor=#999999;strokeWidth=2;endArrow=none;startArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hosthatch" target="dfz">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="e_bb_l" style="edgeStyle=none;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=3;endArrow=none;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="br1" target="backbone">
