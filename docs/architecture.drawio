    <mxCell id="e_xc_l" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;strokeWidth=3;endArrow=none;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="er1" target="xc">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_xc_r" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;strokeWidth=3;endArrow=none;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="xc" target="er2">
