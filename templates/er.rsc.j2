# =====================================================================
#  {{ r.fqdn }} (Edge Router · AS{{ t.asn }}
#  GENERATED by generate.py from topology.yml) DO NOT EDIT BY HAND.
#  CONTAINS PRIVATE KEYS. Don't commit.
# =====================================================================
{% set xc_ip = t.home.xc_net.split('/')[0].rsplit('.',1)[0] ~ '.' ~ (t.home.xc_net.split('/')[0].rsplit('.',1)[1] | int + r.index - 1) %}
{% set transit_ip = t.home['transit_er' ~ r.index] %}
{% set bfd_on = ' use-bfd=yes' if t.bfd.use_ospf else '' %}
{# The ER: lives at home, behind CGNAT, and still has a better uptime story than
most of the appliances in the house. #}

/system/identity set name={{ r.fqdn }}

{% include '_mgmt.j2' %}

/interface/bridge add name=lo0 protocol-mode=none
/ip/address add address={{ r.loopback }}/32 interface=lo0
{% if d.v6 %}
/ipv6/address add address={{ r.loopback6 }}/128 interface=lo0 advertise=no
{% endif %}

/ip/firewall/connection/tracking set enabled=yes
/ip/firewall/raw
add chain=prerouting action=notrack dst-address-type=!local \
    comment="transit is stateless; router-destined traffic stays tracked"
/ip/settings set rp-filter=loose

# --- per-WAN routing tables ------------------------------------------
# Declared up here, before the WANs, because a dhcp-client below names its
# table in default-route-tables and RouterOS resolves that name at add time.
# The mangle rules that steer traffic INTO these tables live further down.
/routing/table
{% for w in r.wans %}
add name=via-{{ w.id }} fib
{% endfor %}

# --- WANs. wan1 = primary, wan2 = backup. Media-agnostic: preference is
#     expressed ONLY as OSPF cost, never in BGP.
#
# Purge any factory dhcp-client on each WAN before we configure it. See the same
# note in br.rsc.j2. A reset can leave a dhcp-client with add-default-route=yes
# distance=1 on ether1; that route beats the iBGP default from the BRs (200) and
# quietly steals every bit of customer egress. Unlike the BRs this is NOT
# ansible's job to clean up: the enforce task there's BR-only on purpose,
# because an ER's WANs are data-driven (address present => static, absent =>
# dhcp-client) and ansible can't tell a factory client from an intended one.
# The template can, because it knows which interface is which.
{% for w in r.wans %}
/ip/dhcp-client remove [find interface={{ w.interface }}]
{% if w.address is defined %}
/ip/address remove [find interface={{ w.interface }}]
/ip/address add address={{ w.address }} interface={{ w.interface }} comment="{{ w.id }}"
{% else %}
# default-route-tables puts the lease's default straight into via-{{ w.id }} and
# lets the client own its lifecycle (installed on bind, withdrawn on release).
# It replaces a script= that rebuilt the route by hand: the escaping needed to
# survive .rsc import mangled \$"gateway-address", so the script ran but the
# route never appeared. Nothing here may land in main. An ER's egress default
# is the iBGP one from the BRs.
/ip/dhcp-client add interface={{ w.interface }} default-route-tables=via-{{ w.id }} \
    use-peer-dns=no use-peer-ntp=no comment="{{ w.id }}"
{% endif %}
{% endfor %}

# --- WireGuard: one interface per BR per WAN --------------------------
# The BR's LISTEN PORT selects the WAN: 518xx = wan1, 519xx = wan2. That's
# what lets two tunnels share one BR public IP. The dst port differs, so
# the mangle rules below can pin them to different WANs.
/interface/wireguard
{% for x in r.tunnels %}
add name={{ x.iface }} listen-port={{ x.listen_port }} mtu={{ t.wg_mtu }} private-key="{{ x.private }}"
{% endfor %}

/interface/wireguard/peers
{% for x in r.tunnels %}
add interface={{ x.iface }} public-key="{{ x.peer_public }}" preshared-key="{{ x.psk }}" endpoint-address={{ x.endpoint }} endpoint-port={{ x.endpoint_port }} allowed-address={{ '0.0.0.0/0,::/0' if d.v6 else '0.0.0.0/0' }} persistent-keepalive=25s name="{{ x.peer_name }}"
{% endfor %}

/ip/address
{% for x in r.tunnels %}
add address={{ x.address }} interface={{ x.iface }}
{% endfor %}
{% if d.v6 %}
# ::/0 in allowed-address is mandatory. See the note in br.rsc.j2. Without it
# the tunnel comes up, v4 is perfect, and v6 vanishes inside WireGuard silently.
/ipv6/address
{% for x in r.tunnels %}
add address={{ x.address6 }} interface={{ x.iface }} advertise=no
{% endfor %}
{% endif %}

/interface/list
add name=tun-wan1
add name=tun-wan2
add name=tunnels include=tun-wan1,tun-wan2
/interface/list/member
{% for x in r.tunnels %}
add list=tun-{{ x.link_class }} interface={{ x.iface }}
{% endfor %}

# --- ER interconnect + firewall transit ------------------------------
# No VRRP. The firewall peers eBGP with BOTH ERs over this /29 and ECMPs its
# egress default across them (advertised in cust-out). Liveness is the BGP
# session/route, not a VRRP hello. So a half-dead box that still answers a
# ping but has stopped forwarding no longer holds the VIP.
/ip/address
add address={{ xc_ip }}/31 interface={{ r.xc_interface }} comment="er interconnect"
add address={{ transit_ip }}/29 interface={{ r.transit_interface }} comment="firewall transit"
{% if d.v6 %}
/ipv6/address
add address={{ r.xc_ip6 }}/127 interface={{ r.xc_interface }} advertise=no comment="er interconnect"
# advertise=no on the transit /64 too, even though it IS a real LAN segment.
# The firewalls sit here at STATIC addresses ({{ t.home.transit_net_v6 }}) and peer eBGP
# from them; an RA would offer them SLAAC addresses and a default gateway they
# must not use: egress is chosen by the BGP default in cust-out, not by an RA.
add address={{ r.transit_ip6 }}/64 interface={{ r.transit_interface }} advertise=no comment="firewall transit"
# A forwarding router ignores RAs by default; state it explicitly so nothing on
# the home LAN can ever hand an ER a default route.
/ipv6/settings set accept-router-advertisements=no
{% endif %}

# --- pin each tunnel family to its WAN -------------------------------
# chain=output only. Never touches the transit fast path. The via-* tables
# themselves are created above, with the WANs. The outer-port range per WAN is
# derived in generate.py off the same base as the BR's listen port. See
# wan_port_base there. Don't restate 51820/51920 in this file.
/ip/firewall/mangle
{% for w in r.wans %}
add chain=output action=mark-routing new-routing-mark=via-{{ w.id }} passthrough=no \
    protocol=udp dst-port={{ w.wg_ports }} comment="WG outer -> {{ w.id }}"
{% endfor %}

# --- and make the SOURCE ADDRESS agree with the WAN the mark chose ----
# THE MARK ALONE IS NOT ENOUGH, and what it leaves behind is silent. RouterOS's
# output path is:
#
#     Routing Decision -> Mangle Output -> Routing Adjustment
#
# The source address is assigned at the FIRST Routing Decision, out of `main`.
# The mark set in Mangle Output is honoured only at Routing Adjustment, which
# re-picks the ROUTE and does NOT re-pick the source. So a packet marked
# via-{{ r.wans[1].id }} leaves {{ r.wans[1].interface }} carrying {{ r.wans[0].id }}'s address, because main's
# only route to a BR public is the {{ r.wans[0].id }} /32 below.
#
# What that looks like on the wire (diagnosed on er1 2026-08-10, AD-LOG §23):
# a CGNAT'd 5G CPE masquerades the packet anyway, so the BR receives the
# handshake and answers it: BOTH counters move on the BR, which is what makes
# this look like carrier filtering. The answer is then un-NATted back to
# {{ r.wans[0].id }}'s address, which the CPE routes out its OWN uplink rather than down to
# the ER. The ER sees zero RX for ever and the handshake retries until you look
# at /ip/firewall/connection and find src-address is the wrong WAN's.
#
# srcnat runs AFTER Routing Adjustment, so it's the first place that can see
# the real egress interface. masquerade rather than src-nat to-address= because
# a DHCP WAN has no address to hard-code.
#
# SAFE ON A ROUTER THAT DOES STATELESS TRANSIT, two ways over: the match is udp
# + this WAN's outer ports + this one interface, so customer traffic can never
# reach it; and the transit path is notrack'd at the top of this file, and an
# untracked packet can't be NATted at all. The tunnels' own outer flows ARE
# tracked (that raw rule is chain=prerouting, which router-originated packets
# never traverse) which is equally what lets the input chain go on accepting
# the replies as `established` without opening a new hole for them.
#
# Rendered for EVERY WAN, not only the one that needs it today. On whichever WAN
# main already prefers this is a no-op, and WHICH WAN THAT IS depends on which
# ones happen to be static. Not a fact to bake a rule set around.
/ip/firewall/nat
{% for w in r.wans %}
add chain=srcnat action=masquerade out-interface={{ w.interface }} protocol=udp \
    dst-port={{ w.wg_ports }} comment="WG outer -> {{ w.id }}: src must match egress"
{% endfor %}

/ip/route
{% for w in r.wans %}
{% if w.gateway is defined %}
add dst-address=0.0.0.0/0 gateway={{ w.gateway }} routing-table=via-{{ w.id }}
{% endif %}
{% endfor %}
# main-table /32s: management path to the BR publics, and a safe landing spot
# for any WG packet that escapes the marks (otherwise it recurses into a tunnel).
{% for br in d.brs %}
{% if r.wans[0].gateway is defined %}
add dst-address={{ br.wan_address }}/32 gateway={{ r.wans[0].gateway }} distance=1  comment="{{ br.name }} via wan1"
{% endif %}
{% if r.wans[1].gateway is defined %}
add dst-address={{ br.wan_address }}/32 gateway={{ r.wans[1].gateway }} distance=10 comment="{{ br.name }} via wan2"
{% endif %}
{% endfor %}

# --- what this ER advertises: its attached customer block -------------
# output.network sends the /25 ONLY while a matching active route exists. That
# matching route is the home-anchor below (a blackhole, exactly like the BR's
# /24 anchor) so origination is gated on the anchor, NOT on the /25 forwarding
# to any single box. (network-blackhole=no on the ibgp template is what stops
# RouterOS from inventing its own blackhole and making this anchor a no-op.)
/ip/firewall/address-list
add list=advertise address={{ t.blocks.customer_home }} comment="home customer block"

/ip/route
# home-anchor: blackhole the /25. Two intentional jobs:
#   1. origination gate for output.network=advertise. The ER announces the /25
#      into iBGP iff this route is present AND enabled (the home-anchor guard
#      toggles `enabled` on live-VIP presence; see the bottom of this file).
#   2. drop traffic to UNCLAIMED /25 space. Firewall VIPs arrive as eBGP /32s at
#      distance 20 and always win for claimed IPs; anything no live firewall
#      claims falls through to this blackhole instead of looping or leaking.
add dst-address={{ t.blocks.customer_home }} blackhole distance=254 comment="home-anchor"
# LOOP GUARD for the whole /24. Never advertised (the er->br filter rejects it).
add dst-address={{ t.prefix }} blackhole distance=254 comment="loop guard"
{% if d.v6 %}

# The v6 pair, same two roles one family over. The /48 is what this ER puts into
# iBGP; the announced aggregate is a loop guard only here and the er->br filter
# rejects it. Note this guard follows aggregate_v6, NOT the /40 allocation.
# Blackholing the AWS BYOIP range at home would break in-AS reachability to our
# own BYOIP space exactly as it would on a BR.
/ipv6/firewall/address-list
add list=advertise6 address={{ t.blocks_v6.customer_home }} comment="home customer block v6"
/ipv6/route
add dst-address={{ t.blocks_v6.customer_home }} blackhole distance=254 comment="home-anchor6"
add dst-address={{ t.aggregate_v6 }} blackhole distance=254 comment="loop guard v6"
{% endif %}

{% if t.bfd.configure %}
# --- BFD: the fast liveness detector, UNDER OSPF ----------------------
# A config entry here does NOT start anything. It only says "a BFD session on
# this interface is permitted, and these are my timers". Sessions are created
# when a protocol asks for one (use-bfd on the OSPF templates below).
#
# THE DEFAULT IS DENY: RouterOS forbids BFD on every interface not listed in
# this menu.
{% if not t.bfd.customer %}
# So the forbid rule below is redundant TODAY, and is here anyway because the
# transit segment ({{ r.transit_interface }}) is the one place in this AS where UNTRUSTED
# speakers live: the customer firewalls. They are eBGP customers, never OSPF
# neighbours, and must never negotiate BFD with an ER. A future broad
# allow-rule would silently include them; this one doesn't. Entries are
# order-sensitive (first match wins), so the deny leads.
{% else %}
# The transit segment ({{ r.transit_interface }}) is listed below, which is a DELIBERATE
# narrowing of that default: it's the one place in this AS where UNTRUSTED
# speakers live (the customer firewalls) and it used to carry an explicit
# forbid-bfd=yes instead.
#
# What still holds the line is that an entry only PERMITS. RouterOS creates a
# session when a local client registers for one, and the only client on this
# segment is /routing/bgp/connection, one per firewall, each carrying
# use-bfd=yes only if that firewall was flagged in topology.yml. A firewall
# nobody flagged gets no session no matter what it sends at us.
#
# It grants OSPF nothing here either: both instances have {{ r.transit_interface }} as
# `passive` below, so there's no adjacency for a session to attach to.
{% endif %}
#
# min-tx/min-rx are one number per link class. Both ends run the same class, so
# splitting them would only create a way to mismatch them. And BFD negotiates
# max(local min-tx, remote min-rx) regardless.
#
# No firewall change is needed. BFD is UDP/3784, and the input chain already
# accepts `in-interface-list=tunnels`, {{ r.xc_interface }} and
# {{ r.transit_interface }} wholesale, in both families.
/routing/bfd/configuration
{% if t.bfd.customer %}
{% set bc = t.bfd.customer %}
add interfaces={{ r.transit_interface }} min-tx={{ bc.interval }} min-rx={{ bc.interval }} multiplier={{ bc.multiplier }} comment="customer transit: detect ~{{ bc.detect_ms }}ms"
{% else %}
add interfaces={{ r.transit_interface }} forbid-bfd=yes comment="customer transit: never"
{% endif %}
{% for cls, iflist in [('er_xc', r.xc_interface), ('wan1', 'tun-wan1'), ('wan2', 'tun-wan2')] %}
{% set b = t.bfd.links[cls] %}
add interfaces={{ iflist }} min-tx={{ b.interval }} min-rx={{ b.interval }} multiplier={{ b.multiplier }} comment="{{ cls }}: detect ~{{ b.detect_ms }}ms"
{% endfor %}

{% endif %}
# --- OSPF. WAN preference is ENTIRELY this cost. BGP never mentions it.
{% if t.bfd.use_ospf %}
# use-bfd=yes hands liveness to BFD: the adjacency now tears on the BFD
# session's clock instead of waiting out dead-interval. The hello/dead timers
# are UNCHANGED on purpose: BFD is additive, so a session that fails to
# establish leaves this router behaving exactly as it did before BFD existed.
#
# It's NOT on the passive templates. lo0 and {{ r.transit_interface }} form no
# adjacency, so there's nothing for BFD to tear.
{% if t.bfd.customer %}
#
# The BFD that DOES run on the transit segment belongs to the eBGP sessions
# further down, not to OSPF. A customer is never an OSPF neighbour here.
{% endif %}
{% endif %}
/routing/ospf/instance add name=core version=2 router-id={{ r.loopback }}
/routing/ospf/area add name=bb instance=core area-id=0.0.0.0
/routing/ospf/interface-template
add area=bb interfaces=lo0 passive
add area=bb interfaces={{ r.transit_interface }} passive comment="pfSense transit"
add area=bb interfaces={{ r.xc_interface }} type=ptp cost={{ t.ospf_cost.er_xc }}{{ bfd_on }}
add area=bb interfaces=tun-wan1 type=ptp cost={{ t.ospf_cost.wan1 }} hello-interval=5s  dead-interval=20s{{ bfd_on }}
add area=bb interfaces=tun-wan2 type=ptp cost={{ t.ospf_cost.wan2 }} hello-interval=10s dead-interval=40s{{ bfd_on }}
{% if d.v6 %}

# --- OSPFv3: separate instance, v4 router-id, identical costs ---------
# Same reasoning as on the BRs: an OSPFv3 router-id is still 32-bit, and the
# costs must match OSPFv2 or a single link failure moves one family and not the
# other. The transit interface is passive. The firewalls are eBGP customers,
# never OSPF neighbours, and an OSPF adjacency to a customer would hand them the
# internal topology.
{% if t.bfd.use_ospf %}
#
# BFD is per-family as well: OSPFv3 neighbours are link-local v6 addresses, so
# this instance builds its OWN BFD session over each link alongside the v4 one.
# The /routing/bfd/configuration entries above match on INTERFACE, not family,
# so both sessions inherit the same class timers. {% if t.bfd.customer %}which is also why the transit
# entry needs no v6 counterpart for the v6 customer sessions{% else %}and the transit forbid rule
# covers v6 too{% endif %}.
{% endif %}
/routing/ospf/instance add name=core6 version=3 router-id={{ r.loopback }}
/routing/ospf/area add name=bb6 instance=core6 area-id=0.0.0.0
/routing/ospf/interface-template
add area=bb6 interfaces=lo0 passive
add area=bb6 interfaces={{ r.transit_interface }} passive comment="firewall transit"
add area=bb6 interfaces={{ r.xc_interface }} type=ptp cost={{ t.ospf_cost.er_xc }}{{ bfd_on }}
add area=bb6 interfaces=tun-wan1 type=ptp cost={{ t.ospf_cost.wan1 }} hello-interval=5s  dead-interval=20s{{ bfd_on }}
add area=bb6 interfaces=tun-wan2 type=ptp cost={{ t.ospf_cost.wan2 }} hello-interval=10s dead-interval=40s{{ bfd_on }}
{% endif %}

# --- BGP instance: router-id lives HERE, not on templates/connections.
#
# multipath is BGP ECMP, and it's a COUNT of routes to install (type `num`),
# not a switch (`multipath=yes` aborts the import. Without it this ER holds
# two IDENTICAL defaults, one per BR) same local-pref, same empty AS_PATH,
# same IGP metric, because both BR loopbacks sit behind the one tun-wan1. And
# installs whichever won a router-id tie-break. That's a pinned egress nobody
# chose. With it, both are installed; the moment te.local_pref makes them
# unequal it collapses back to the preferred one on its own. It's also what
# makes two firewalls claiming the same VIP at equal local-pref actually ECMP.
/routing/bgp/instance
add name=core as={{ t.asn }} router-id={{ r.loopback }}{% if t.bgp_multipath %} multipath={{ t.bgp_multipath }}{% endif %}


# A connection with no templates= inherits `default`. Keep it bare.
/routing/bgp/template set default output.filter-chain="" output.network=""

# --- iBGP: FULL MESH. This ER originates its /25, so force-self is right.
# Templates hold protocol/policy only: `afi` (not address-families), no
# local.*/remote.*, no router-id.
#
# output.filter-chain is NOT on the template any more: er->br and er->er need
# DIFFERENT output policy (see the two chains below), and a template can only
# carry one. It moves to the connection, next to local.*/remote.*.
#
# The chain is picked by ibgp_out_class, not by role. A remote site is a `sr`,
# but on output it's treated EXACTLY like a BR. It gets the {{ t.blocks.customer_home }}
# aggregate and none of the customer more-specifics, which stay home. Giving it
# its own chain would only be a second copy of ibgp-out-br to keep in step.
/routing/bgp/template
add name=ibgp afi=ip multihop=yes nexthop-choice=force-self \
    output.network=advertise \
    output.network-blackhole=no

/routing/bgp/connection
{% for p in r.ibgp_peers %}
add name=ibgp-{{ p.name }} instance=core templates=ibgp \
    local.address={{ r.loopback }} local.role=ibgp \
    remote.address={{ p.loopback }} remote.as={{ t.asn }} \
    input.filter={{ p.ibgp_in_chain }} \
    output.filter-chain=ibgp-out-{{ p.ibgp_out_class }}
{% endfor %}

/routing/filter/rule
add chain=ibgp-in rule="accept"
{% if d.ibgp_in_lps %}

# --- EGRESS TE: which BR this ER leaves through -----------------------
# A BR sends us exactly one thing over iBGP, 0.0.0.0/0, and every BR's copy is
# otherwise identical. local-pref is the FIRST tie-break in best-path, so it's
# the only attribute that decides this without touching an IGP cost. Which is
# the point: WAN preference (wan1 vs wan2) stays OSPF cost and BR preference
# (br1 vs br2) is this. Two axes, and they compose.
#
# Set on INPUT here rather than on the BR's ibgp-out: the default is generated
# by output.default-originate, and whether RouterOS runs a generated route
# through the output filter chain isn't something to find out on a live
# network. An inbound UPDATE unquestionably traverses input.filter.
#
# Matched on the default alone. A BR carries nothing else today, but scoping it
# means this knob can't silently reweight whatever a BR starts carrying next.
{% for lp in d.ibgp_in_lps %}
add chain=ibgp-in-lp{{ lp }} rule="if (dst==0.0.0.0/0 && dst-len==0) { set bgp-local-pref {{ lp }}; accept }"
add chain=ibgp-in-lp{{ lp }} rule="accept"
{% endfor %}
{% endif %}

# --- er -> BR output: the BRs (and the DFZ) see EXACTLY ONE thing from home,
# the {{ t.blocks.customer_home }} aggregate. Customer VIP more-specifics are
# denied here; the aggregate keeps covering them.
add chain=ibgp-out-br rule="if (dst=={{ t.prefix }} && dst-len=={{ t.prefix.split('/')[1] }}) { reject }"
# RTBH is EXPLICIT: a /32 is a blackhole request only when the operator has put
# it on the `rtbh` address-list. dst-len==32 alone means NOTHING. Customer
# firewall VIPs are /32s too, and inferring RTBH from prefix length would tag a
# VIP claim as a blackhole request and null it at every upstream. See AD-LOG 9.3.
add chain=ibgp-out-br rule="if (dst in {{ t.prefix }} && dst-len==32 && dst in rtbh) { set bgp-large-communities {{ t.asn }}:1:666; accept }"
{% for c in d.cust_claims %}
add chain=ibgp-out-br rule="if ({{ c.match }}) { reject }" comment="customer {{ 'VIP' if c.exact else 'delegation' }}: stays home"
{% endfor %}
add chain=ibgp-out-br rule="accept"

# --- er -> er output: same, EXCEPT the customer VIP more-specifics are
# permitted. That's what keeps a VIP reachable when the firewall's session to
# ONE ER drops: the surviving ER still has the claim and the other forwards to
# it across the interconnect.
add chain=ibgp-out-er rule="if (dst=={{ t.prefix }} && dst-len=={{ t.prefix.split('/')[1] }}) { reject }"
add chain=ibgp-out-er rule="if (dst in {{ t.prefix }} && dst-len==32 && dst in rtbh) { set bgp-large-communities {{ t.asn }}:1:666; accept }"
add chain=ibgp-out-er rule="accept"
{% if d.v6 %}

# --- iBGP v6: separate sessions, same shape --------------------------
/routing/bgp/template
add name=ibgp6 afi=ipv6 multihop=yes nexthop-choice=force-self \
    output.network=advertise6 \
    output.network-blackhole=no

/routing/bgp/connection
{% for p in r.ibgp_peers %}
add name=ibgp6-{{ p.name }} instance=core templates=ibgp6 \
    local.address={{ r.loopback6 }} local.role=ibgp \
    remote.address={{ p.loopback6 }} remote.as={{ t.asn }} \
    input.filter={{ p.ibgp6_in_chain }} \
    output.filter-chain=ibgp6-out-{{ p.ibgp_out_class }}
{% endfor %}

/routing/filter/rule
add chain=ibgp6-in rule="accept"
{% if d.ibgp_in_lps %}
# Same egress preference on ::/0. The families are steered together or the AS
# leaves through one BR on v4 and the other on v6.
{% for lp in d.ibgp_in_lps %}
add chain=ibgp6-in-lp{{ lp }} rule="if (dst==::/0 && dst-len==0) { set bgp-local-pref {{ lp }}; accept }"
add chain=ibgp6-in-lp{{ lp }} rule="accept"
{% endfor %}
{% endif %}

# er -> BR: the DFZ sees exactly one thing from home, {{ t.blocks_v6.customer_home }}.
add chain=ibgp6-out-br rule="if (dst=={{ t.aggregate_v6 }} && dst-len=={{ t.aggregate_v6.split('/')[1] }}) { reject }"
# RTBH stays EXPLICIT, and the reasoning is even sharper in v6: a /128 is a
# perfectly ordinary customer service address, so length tells you nothing at
# all. Only membership of the rtbh6 list means "blackhole this".
add chain=ibgp6-out-br rule="if (dst in {{ t.aggregate_v6 }} && dst-len==128 && dst in rtbh6) { set bgp-large-communities {{ t.asn }}:1:666; accept }"
{% for c in d.cust_claims6 %}
add chain=ibgp6-out-br rule="if ({{ c.match }}) { reject }" comment="customer {{ 'VIP' if c.exact else 'delegation' }}: stays home"
{% endfor %}
add chain=ibgp6-out-br rule="accept"

# er -> er: identical, except customer more-specifics are permitted so a VIP
# survives losing its session to ONE ER.
add chain=ibgp6-out-er rule="if (dst=={{ t.aggregate_v6 }} && dst-len=={{ t.aggregate_v6.split('/')[1] }}) { reject }"
add chain=ibgp6-out-er rule="if (dst in {{ t.aggregate_v6 }} && dst-len==128 && dst in rtbh6) { set bgp-large-communities {{ t.asn }}:1:666; accept }"
add chain=ibgp6-out-er rule="accept"
{% endif %}
{% if r.firewalls %}

# =====================================================================
#  Customer firewalls: eBGP, private ASN, VIP claims out of the /25.
#  NOT members of AS64500. Never in the iBGP mesh. No WireGuard.
# =====================================================================
{% for fw in r.firewalls %}

# --- customer firewall: {{ fw.name }} (AS{{ fw.asn }}) ---------------------------
{% if fw.bfd %}
# use-bfd=yes: this session's liveness comes from the BFD session on
# {{ r.transit_interface }} (permitted above at {{ t.bfd.customer.interval }} x {{ t.bfd.customer.multiplier }}), not from the
# BGP hold time. A firewall that stops forwarding is noticed in ~{{ t.bfd.customer.detect_ms }}ms
# instead of ~3 minutes, and its VIPs are withdrawn that fast. Which is what
# the second firewall, and the home-anchor guard, are waiting on.
#
# {{ fw.name }} was flagged `bfd: true` in topology.yml, which is a statement that
# BFD is CONFIGURED AND VERIFIED on that box. It's not a wish: an ER asking a
# firewall for a session the firewall never answers is the one failure this
# feature is supposed to prevent.
{% endif %}
/routing/bgp/connection
add name=cust-{{ fw.name }} instance=core \
    local.address={{ transit_ip }} local.role=ebgp-customer \
    remote.address={{ fw.peer_address }} remote.as={{ fw.asn }} \
    input.filter=cust-in-{{ fw.name }} output.filter-chain=cust-out \
    output.default-originate=if-installed \
{% if fw.bfd %}    use-bfd=yes \
{% endif %}    input.limit-process-routes-ipv4={{ fw.max_routes }}

/routing/filter/rule
# The security boundary. {{ fw.name }} gets these {{ fw.claims | length }} grant(s) and nothing else.
# An exact VIP matches one prefix at one length; a delegation matches anything
# inside the block between the stated dst-len bounds. The trailing reject is
# what makes this a whitelist. Never remove it.
{% for c in fw.claims %}
{% if c.exact %}
add chain=cust-in-{{ fw.name }} rule="if ({{ c.match }}) { {% if fw.local_pref %}set bgp-local-pref {{ fw.local_pref }}; {% endif %}accept }" comment="vip {{ c.prefix }}"
{% else %}
add chain=cust-in-{{ fw.name }} rule="if ({{ c.match }}) { {% if fw.local_pref %}set bgp-local-pref {{ fw.local_pref }}; {% endif %}accept }" comment="delegation {{ c.prefix }} up to /{{ c.max_len }}"
{% endif %}
{% endfor %}
add chain=cust-in-{{ fw.name }} rule="reject"
{% if d.v6 and fw.claims6 %}

# --- {{ fw.name }} over IPv6: a SEPARATE eBGP session ------------------------
# Separate for the same reason the iBGP sessions are: force-self stays trivial,
# and the families fail independently. Note limit-process-routes-ipv6 is its own
# knob: {{ fw.max_routes_v6 }} here, derived from what these grants could legitimately
# produce ({{ fw.claims6 | map(attribute='capacity') | sum }} routes) plus headroom. Sharing one budget with v4
# would let a v6 flood starve the v4 session.
{% if fw.bfd %}
#
# Its own BFD session, for the same reason it's its own BGP session: sessions
# are keyed on (interface, local address, remote address, FAMILY), so the v4
# session above can't speak for this one. The transit entry in
# /routing/bfd/configuration matches on interface only, so both inherit the
# same timers with nothing extra to configure.
{% endif %}
/routing/bgp/connection
add name=cust6-{{ fw.name }} instance=core \
    local.address={{ r.transit_ip6 }} local.role=ebgp-customer \
    remote.address={{ fw.peer_address_v6 }} remote.as={{ fw.asn }} \
    input.filter=cust6-in-{{ fw.name }} output.filter-chain=cust6-out \
    output.default-originate=if-installed \
{% if fw.bfd %}    use-bfd=yes \
{% endif %}    input.limit-process-routes-ipv6={{ fw.max_routes_v6 }}

/routing/filter/rule
# Same whitelist, same trailing reject. {{ fw.name }} gets {{ fw.claims6 | length }} v6 grant(s).
{% for c in fw.claims6 %}
{% if c.exact %}
add chain=cust6-in-{{ fw.name }} rule="if ({{ c.match }}) { {% if fw.local_pref %}set bgp-local-pref {{ fw.local_pref }}; {% endif %}accept }" comment="vip {{ c.prefix }}"
{% else %}
add chain=cust6-in-{{ fw.name }} rule="if ({{ c.match }}) { {% if fw.local_pref %}set bgp-local-pref {{ fw.local_pref }}; {% endif %}accept }" comment="delegation {{ c.prefix }} up to /{{ c.max_len }}"
{% endif %}
{% endfor %}
add chain=cust6-in-{{ fw.name }} rule="reject"
{% endif %}
{% endfor %}

# --- cust-out: hand the firewall a DEFAULT, and nothing else ----------
# VRRP is gone, so the firewall's egress default now comes from BGP. Both ERs
# advertise 0.0.0.0/0 (output.default-originate=if-installed on each cust
# connection), so the firewall ECMPs its outbound across er1/er2 and drops an ER
# the instant that ER loses its OWN upstream (the default stops being installed
# here, so we stop originating it). Only the default may leave. Reject
# everything else so no internal prefix can ever leak to a customer.
/routing/filter/rule
add chain=cust-out rule="if (dst==0.0.0.0/0 && dst-len==0) { accept }"
add chain=cust-out rule="reject"
{% if d.v6 %}
add chain=cust6-out rule="if (dst==::/0 && dst-len==0) { accept }"
add chain=cust6-out rule="reject"
{% endif %}
{% if d.cust_claims %}

# =====================================================================
#  home-anchor guard: originate the /25 only while a VIP is actually live.
# =====================================================================
# The /25 aggregate must ride on REAL customer reachability, not a ping. A
# firewall proves it's alive by advertising a VIP, which the ER installs as an
# active eBGP /32. This guard ENABLES the home-anchor (=> originate the /25)
# while >=1 VIP is active and disables it when the last one vanishes. At which
# point the BRs' own anchor-guard stops seeing the /25 and withdraws the /24.
# Same shape and same safe default as the BR anchor-guard: the anchor ships
# ENABLED (keep originating); arm the scheduler once you trust the signal.
/system/script
add name=home-anchor-guard policy=read,write,test source={
  :local live 0
{% for c in d.cust_claims %}
{% if c.exact %}
  :if ([:len [/ip/route/find where {{ c.find }} && active]] > 0) do={ :set live ($live + 1) }
{% else %}
  # delegation {{ c.prefix }}: ANY active route inside the block proves the
  # firewall is alive. We don't care which more-specifics it chose to carve.
  :if ([:len [/ip/route/find where {{ c.find }} && active]] > 0) do={ :set live ($live + 1) }
{% endif %}
{% endfor %}
  :local down [/ip/route/find where comment="home-anchor" && disabled=yes]
  :if ($live > 0) do={
    :if ([:len $down] > 0) do={
      /ip/route/set [find where comment="home-anchor"] disabled=no
      :log warning ("home-anchor-guard: RE-ORIGINATING {{ t.blocks.customer_home }} live-vips=$live")
    }
  } else={
    :if ([:len $down] = 0) do={
      /ip/route/set [find where comment="home-anchor"] disabled=yes
      :log error ("home-anchor-guard: WITHDRAWING {{ t.blocks.customer_home }} live-vips=0")
    }
  }
{% if d.v6 and d.cust_claims6 %}

  # The v6 anchor is judged on v6 evidence ONLY. A firewall whose v4 session is
  # up but whose v6 session is down isn't delivering v6, and continuing to
  # originate {{ t.blocks_v6.customer_home }} on its behalf would black-hole
  # traffic at hdc that the BRs could otherwise have dropped closer to the edge.
  :local live6 0
{% for c in d.cust_claims6 %}
  :if ([:len [/ipv6/route/find where {{ c.find }} && active]] > 0) do={ :set live6 ($live6 + 1) }
{% endfor %}
  :local down6 [/ipv6/route/find where comment="home-anchor6" && disabled=yes]
  :if ($live6 > 0) do={
    :if ([:len $down6] > 0) do={
      /ipv6/route/set [find where comment="home-anchor6"] disabled=no
      :log warning ("home-anchor-guard: RE-ORIGINATING {{ t.blocks_v6.customer_home }} live-vips6=$live6")
    }
  } else={
    :if ([:len $down6] = 0) do={
      /ipv6/route/set [find where comment="home-anchor6"] disabled=yes
      :log error ("home-anchor-guard: WITHDRAWING {{ t.blocks_v6.customer_home }} live-vips6=0")
    }
  }
{% endif %}
}
# Prove the customer routes actually show up as active before arming the guard:
#   /ip/route/print where dst in {{ t.blocks.customer_home }} && dst-len==32 && active
/system/scheduler add name=home-anchor-guard interval=10s on-event=home-anchor-guard policy=read,write,test
{% endif %}
{% endif %}

# --- MSS clamp. The one thing allowed in the forward chain. -----------
/ip/firewall/mangle
add chain=forward action=change-mss new-mss={{ t.mss_clamp }} passthrough=yes \
    protocol=tcp tcp-flags=syn tcp-mss={{ t.mss_clamp + 1 }}-65535 out-interface-list=tunnels
add chain=forward action=change-mss new-mss={{ t.mss_clamp }} passthrough=yes \
    protocol=tcp tcp-flags=syn tcp-mss={{ t.mss_clamp + 1 }}-65535 in-interface-list=tunnels

# --- input -----------------------------------------------------------
/ip/firewall/filter
add chain=input action=accept connection-state=established,related
add chain=input action=accept protocol=icmp comment="PMTUD/QUIC - never break this"
add chain=input action=accept in-interface-list=tunnels
add chain=input action=accept in-interface={{ r.xc_interface }}
add chain=input action=accept in-interface={{ r.transit_interface }}
{% if t.snmp is defined and t.snmp and t.snmp.enabled %}
# SNMPv3 polling. Belt-and-braces on an ER (a poller at home already arrives
# on {{ r.transit_interface }} or a tunnel, both accepted above) but stated
# anyway, so that tightening those blanket interface accepts later doesn't
# silently take monitoring with them.
add chain=input action=accept protocol=udp dst-port=161 src-address-list=snmp comment="SNMPv3 poller"
{% endif %}
add chain=input action=accept src-address-list=mgmt
{% for w in r.wans %}
add chain=input action=drop in-interface={{ w.interface }}
{% endfor %}
{% if d.v6 %}

# --- input v6 ---------------------------------------------------------
# The ER WANs are v4-only (residential fibre + CGNAT'd 5G), so there's no v6
# WAN to defend here: v6 reaches this box only through the tunnels and the
# home segments. The trailing drop is still terminal.
/ipv6/firewall/filter
add chain=input action=accept connection-state=established,related
# ICMPv6 carries Neighbour Discovery: drop it and the transit /64 stops
# resolving the firewalls entirely. Never narrow this to echo.
add chain=input action=accept protocol=icmpv6 comment="ND + PMTUD - never break this"
add chain=input action=accept in-interface-list=tunnels
add chain=input action=accept in-interface={{ r.xc_interface }}
add chain=input action=accept in-interface={{ r.transit_interface }}
add chain=input action=drop

# MSS clamp for v6. The value is {{ t.mss_clamp_v6 }}, NOT the v4 {{ t.mss_clamp }}: both come off the
# same {{ t.wg_mtu }} tunnel MTU, but MSS is what is left after the headers, and the
# IPv6 header is 40 bytes where IPv4's is 20. Clamp v6 to the v4 number and every
# large segment is {{ t.mss_clamp - t.mss_clamp_v6 }} bytes over the tunnel, which survives only if ICMPv6
# Packet Too Big makes it back to the sender. The dependency this rule exists to
# remove, and v6 has no router-side fragmentation to fall back on.
/ipv6/firewall/mangle
add chain=forward action=change-mss new-mss={{ t.mss_clamp_v6 }} passthrough=yes \
    protocol=tcp tcp-flags=syn tcp-mss={{ t.mss_clamp_v6 + 1 }}-65535 out-interface-list=tunnels
add chain=forward action=change-mss new-mss={{ t.mss_clamp_v6 }} passthrough=yes \
    protocol=tcp tcp-flags=syn tcp-mss={{ t.mss_clamp_v6 + 1 }}-65535 in-interface-list=tunnels
{% endif %}

{% include '_snmp.j2' %}
