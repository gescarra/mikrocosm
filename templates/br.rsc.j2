# =====================================================================
#  {{ r.fqdn }} (Border Router · {{ r.provider }} · AS{{ t.asn }}
#  GENERATED by generate.py from topology.yml) DO NOT EDIT BY HAND.
#  CONTAINS PRIVATE KEYS. Don't commit.
# =====================================================================

/system/identity set name={{ r.fqdn }}

{% include '_mgmt.j2' %}

# --- loopback: canonical address, BGP + OSPF router-id ----------------
/interface/bridge add name=lo0 protocol-mode=none
/ip/address add address={{ r.loopback }}/32 interface=lo0
{% if d.v6 %}
# advertise=no: lo0 must never emit Router Advertisements. It's an anchor for
# our own addresses, not a LAN.
/ipv6/address add address={{ r.loopback6 }}/128 interface=lo0 advertise=no
{% endif %}

# --- conntrack ON, transit NOT tracked --------------------------------
# It's the conntrack TABLE, not CPU, that kills a border router. raw runs
# before conntrack, so the transit fast path is untouched.
/ip/firewall/connection/tracking set enabled=yes
/ip/firewall/raw
add chain=prerouting action=notrack dst-address-type=!local \
    comment="transit is stateless; router-destined traffic stays tracked"
/ip/settings set rp-filter=loose

# --- WAN on ether1: STATIC address, NEVER DHCP -----------------------
# ether1 gets a hard-coded provider address. We never run a dhcp-client on it.
#
# PURGE FIRST, and do it HERE rather than in ansible. no-defaults=yes does NOT
# guarantee a clean ether1: some provider CHR images re-create a factory
# dhcp-client on boot after the reset, and it races us to the address. What
# happens next depends on what the segment's DHCP server hands back:
#   - same IP as our static  -> `/ip/address/add` fails "already have such
#     address" and THE WHOLE IMPORT ABORTS HERE, leaving a half-built router;
#   - a different subnet     -> no collision, but its add-default-route=yes
#     distance=1 route silently beats the iBGP default and steals all egress.
# Ansible's post-import purge can't help with either: the first one kills the
# import before ansible regains control, and the second is already routing
# traffic the wrong way by then. The run-after-reset script is the only thing
# guaranteed to run in this context, so the purge belongs in it.
#
# Both removes are idempotent no-ops on a genuinely clean box.
# {{ r.wan_gateway }} is .1 of this /{{ r.wan_prefix }}.
/ip/dhcp-client remove [find interface=ether1]
/ip/address remove [find interface=ether1]
/ip/address add address={{ r.wan_address }}/{{ r.wan_prefix }} interface=ether1 comment="WAN"

# --- ether1 TX queue: {{ r.wan_queue }} ---------------------------------------
# NOT the RouterOS default. Ethernet ships on only-hardware-queue, which drops
# the software queue and feeds the driver ring directly. Correct on physical
# hardware, wrong on a CHR guest whose virtio ring only drains when an
# oversubscribed host schedules the vhost thread. With nothing in front of it,
# every packet arriving during a scheduling gap is dropped (tx-queue-drop), and
# each drop halves the window of a sender crossing this router. The symptom is a
# soft throughput cap at an idle CPU, which looks like anything BUT a queue.
#
# Measured on br1.ord1 (7.24.1): fq-codel ~200 Mb/s, pfifo/50 ~60 Mb/s,
# only-hardware-queue worse still: CPU ~6% throughout. See topology.yml
# `wan_queue` for the full comparison and for why fq-codel is the right SHAPE
# here rather than simply a deeper FIFO.
#
# THIS BLOCK IS WHY THE FIX SURVIVES. The deploy path is reset-configuration +
# run-after-reset (ansible/deploy.yml), so the same change made by hand on the
# router is wiped by the next deploy and the box comes back at a fraction of its
# throughput with nothing in the config to explain it.
{% if r.wan_aqm_create %}
#
# The type must be CREATED before it can be referenced: fq-codel is a KIND, and
# there's no stock /queue/type by that name. Referencing one that doesn't
# exist fails here, on a box reset-configuration has already wiped. Taking
# every /routing/bgp object and every tunnel below this line with it.
#
# Values are the 7.24.1 fq-codel defaults, pinned explicitly so a future release
# can't move them silently: a changed target or limit would surface as a
# throughput regression with nothing in the config to attribute it to.
#
# The re-point + remove is a DOUBLE-IMPORT GUARD, not ceremony. reset-configuration
# always hands us a clean box, so all three lines are no-ops on the deploy path.
# But README documents applying this file by hand with /import, and on a second
# hand-import `/queue/type add` would hit "already have such name" and abort the
# rest of the file. Parking ether1 on a stock type first is what lets the remove
# succeed: RouterOS won't remove a queue type that's in use.
/queue/interface set [find where interface=ether1] queue=only-hardware-queue
/queue/type remove [find where name="{{ t.wan_aqm.name }}"]
/queue/type add name={{ t.wan_aqm.name }} kind=fq-codel \
    fq-codel-target={{ t.wan_aqm.target }} fq-codel-interval={{ t.wan_aqm.interval }} \
    fq-codel-limit={{ t.wan_aqm.limit }} fq-codel-flows={{ t.wan_aqm.flows }} \
    fq-codel-quantum={{ t.wan_aqm.quantum }} fq-codel-memlimit={{ t.wan_aqm.memlimit }} \
    fq-codel-ecn={{ t.wan_aqm.ecn_ros }}
{% endif %}
#
# The wg-* interfaces are deliberately NOT touched here. They stay on
# RouterOS's `no-queue` default. The drops are on ether1, and a queue in front
# of the encrypt path would add a second buffering layer without addressing
# them. Note also that fq-codel on ether1 classifies the ENCRYPTED OUTER
# packets, so it isolates the tunnels and eBGP from each other but can't see
# individual customer flows inside a tunnel. See topology.yml for that trade.
/queue/interface set [find where interface=ether1] queue={{ r.wan_queue }}

# --- provider default: STATIC, distance {{ t.provider_default_distance }} -----------------------
# NOT 250. It must BEAT iBGP (200), or a sibling BR's advertised default wins
# and this router egresses through the sibling's transit. Where its packets,
# sourced from {{ r.wan_address }}, are dropped at the sibling upstream's BCP38
# filter. That includes your SSH to it. It must still LOSE to the eBGP-learned
# default (20) so a real upstream default is preferred when present. Gateway is
# {{ r.wan_gateway }}, resolved over the connected /{{ r.wan_prefix }} statically set on ether1.
{% if r.static_default %}
/ip/route add dst-address=0.0.0.0/0 gateway={{ r.wan_gateway }} distance={{ t.provider_default_distance }} comment="provider default (static)"
{% if d.v6 %}

# --- WAN v6 on ether1 -------------------------------------------------
# {{ r.provider }} hands us {{ r.wan_v6.address }}/{{ r.wan_v6.prefix }}.
# advertise=no for the same reason as lo0: this is an uplink, not a LAN, and a
# BR emitting RAs onto a provider segment is a good way to get de-peered.
/ipv6/address remove [find interface=ether1]
/ipv6/address add address={{ r.wan_v6.address }}/{{ r.wan_v6.prefix }} interface=ether1 advertise=no comment="WAN v6"
{% if r.wan_v6.gateway | lower == 'ra' %}

# {{ r.provider }} announces the default by ROUTER ADVERTISEMENT only. There's
# no static v6 gateway to configure. A FORWARDING router ignores RAs by default
# (the RouterOS default is yes-if-forwarding-disabled), so without this line the
# box silently has no IPv6 default route at all: v4 keeps working and nothing
# looks wrong until a v6-only destination fails.
#
# This setting is GLOBAL, not per-interface. RouterOS has no per-interface
# accept knob. That means every interface would honour an RA, including the
# WireGuard tunnels, where a compromised peer could inject a default and steal
# egress. The input-chain rule further down drops ICMPv6 type 134 arriving on
# `tunnels`, which is what makes this setting safe to turn on.
#
# !! THIS SETTING NEEDS A REBOOT TO TAKE EFFECT. RouterOS flags it with a red
# !! banner in WinBox. Until the box reboots it holds the setting, accepts the
# !! RA, and STILL doesn't route IPv6 to the gateway. While v4 works
# !! perfectly, so nothing looks wrong. The reboot that reset-configuration
# !! already did doesn't count: it happened before this line ran, when the
# !! setting was still at its factory default.
# !!
# !! ansible/deploy.yml reboots unconditionally after applying any config (the
# !! ERs and the static-gateway BR change this value too, just to `no`), then
# !! asserts an active ::/0 exists here. If you apply this file BY HAND, reboot
# !! afterwards and check:
# !!     /ipv6/route print where dst-address="::/0"
{# v4 works, v6 doesn't, nothing logs a thing. RouterOS's favourite magic trick. #}
/ipv6/settings set accept-router-advertisements=yes
{% else %}

# {{ r.provider }} uses a FIXED gateway at {{ r.wan_v6.gateway }}.
# The %ether1 scope is MANDATORY on a link-local next-hop: fe80::/10 is
# ambiguous across interfaces and RouterOS can't resolve it unscoped.
# Distance {{ t.provider_default_distance }} for exactly the v4 reasoning: beat iBGP (200) so this
# router never egresses through a sibling and dies at their BCP38 filter, but
# lose to the eBGP-learned default (20).
/ipv6/settings set accept-router-advertisements=no
/ipv6/route add dst-address=::/0 gateway={{ r.wan_v6.gateway }}%ether1 distance={{ t.provider_default_distance }} comment="provider default v6 (static)"
{% endif %}
{% endif %}
{% endif %}

# =====================================================================
#  RECURSION GUARDS. A tunnel's OUTER destination must never resolve
#  through a route that could point INTO a tunnel.
# =====================================================================
/ip/route
# The eBGP peer. Link-local, normally reached via the default. And once the
# default is BGP-learned, its own next-hop would resolve only via itself.
add dst-address={{ r.peer_address }}/32 gateway={{ r.wan_gateway }} distance=1 \
    comment="eBGP peer"
{% for sib in r.sibling_publics %}
# {{ sib.name }}'s public: the outer destination of the wg-{{ sib.name }} backbone tunnel.
# Without this, it resolves via the default. Whose next-hop may be {{ sib.name }}
# itself, reached through the very tunnel we're trying to route. Permanent flap.
add dst-address={{ sib.wan_address }}/32 gateway={{ r.wan_gateway }} distance=1 \
    comment="wg endpoint {{ sib.name }}"
{% endfor %}
{% for pin in r.peer_endpoint_pins if pin.family == 4 %}
# Peer {{ pin.name }}'s endpoint. Same guard as the siblings above, and MORE
# likely to be needed: a peer can advertise a prefix that covers its own tunnel
# endpoint. Accept that route and the outer destination resolves through the
# tunnel carrying it: a permanent flap that reads as the far end's fault.
add dst-address={{ pin.address }}/32 gateway={{ r.wan_gateway }} distance=1 \
    comment="peer endpoint {{ pin.name }}"
{% endfor %}

{% if d.v6 %}
{% if r.wan_v6.gateway | lower != 'ra' %}
/ipv6/route
# Same recursion guard as the v4 peer above, and needed for the same reason:
# {{ r.peer_v6_address }} is NOT on-link in {{ r.wan_v6.address }}/{{ r.wan_v6.prefix }}, so it
# resolves via the default: and the static v6 default sits at distance
# {{ t.provider_default_distance }}, which LOSES to an eBGP-learned default (20). Once the session
# comes up, the peer's own next-hop would resolve through the session itself.
add dst-address={{ r.peer_v6_address }}/128 gateway={{ r.wan_v6.gateway }}%ether1 distance=1 \
    comment="eBGP peer v6"
{% else %}
# NOTE: no static pin for {{ r.peer_v6_address }}, deliberately. {{ r.provider }}'s gateway is
# RA-learned, so there's no stable next-hop address to pin against. The
# recursion this would guard against can't occur here anyway: RouterOS installs
# the RA default at distance 1, which BEATS an eBGP-learned default (20), so the
# peer never resolves through its own session.
#
# The trade is that v6 egress preference is decided by the RA, not by
# provider_default_distance ({{ t.provider_default_distance }}) as it's on v4. Both point at
# {{ r.provider }}, so the choice is immaterial today. But it's a real
# asymmetry between the families, and worth remembering before adding a second
# v6 upstream here.
{% endif %}
{% endif %}

# --- origination anchor (distance 254: loses to everything) -----------
{# Distance 254: the participation trophy of routes. It exists so the prefix does. #}
/ip/firewall/address-list add list=my-aggregate address={{ t.prefix }}
/ip/route
add dst-address={{ t.prefix }} blackhole distance=254 comment="anchor"
{% if d.v6 %}
# The v6 anchor is the identical mechanism one family over: a blackhole that
# loses to everything, whose EXISTENCE is what output.network turns into an
# origination of {{ t.aggregate_v6 }}. anchor-guard toggles both together.
/ipv6/firewall/address-list add list=my-aggregate6 address={{ t.aggregate_v6 }}
/ipv6/route
add dst-address={{ t.aggregate_v6 }} blackhole distance=254 comment="anchor6"
{% endif %}

# --- WireGuard: tunnels to the ERs -----------------------------------
# No endpoint: the ERs are behind NAT and always initiate.
{% if d.sites %}
#
# A site is a CONSOLIDATED edge router with one WAN, and it dials every BR.
# There's no primary/backup pinning. On this side that makes it identical to an
# ER tunnel, so it rides the same list; only the listen port class differs
# (520xx = site, against 518xx/519xx for the ER WANs).
{% endif %}
/interface/wireguard
{% for x in r.tunnels %}
add name={{ x.iface }} listen-port={{ x.listen_port }} mtu={{ t.wg_mtu }} private-key="{{ x.private }}"
{% endfor %}

/interface/wireguard/peers
{% for x in r.tunnels %}
add interface={{ x.iface }} public-key="{{ x.peer_public }}" preshared-key="{{ x.psk }}" allowed-address={{ '0.0.0.0/0,::/0' if d.v6 else '0.0.0.0/0' }} persistent-keepalive=25s name="{{ x.peer_name }}"
{% endfor %}

/ip/address
{% for x in r.tunnels %}
add address={{ x.address }} interface={{ x.iface }}
{% endfor %}
{% if d.v6 %}
# allowed-address above MUST list ::/0 as well as 0.0.0.0/0. WireGuard's
# allowed-address is a cryptographic routing gate, not a filter you can bolt v6
# onto later: with only 0.0.0.0/0 the tunnel comes up, v4 works perfectly, and
# every v6 packet is silently discarded inside WireGuard before it reaches the
# firewall or the routing table. There's no log line for it.
/ipv6/address
{% for x in r.tunnels %}
add address={{ x.address6 }} interface={{ x.iface }} advertise=no
{% endfor %}
{% endif %}

{% if r.backbone %}
# --- WireGuard: BR<->BR backbone -------------------------------------
/interface/wireguard
{% for x in r.backbone %}
add name={{ x.iface }} listen-port={{ x.listen_port }} mtu={{ t.wg_mtu }} private-key="{{ x.private }}"
{% endfor %}

/interface/wireguard/peers
{% for x in r.backbone %}
add interface={{ x.iface }} public-key="{{ x.peer_public }}" preshared-key="{{ x.psk }}" endpoint-address={{ x.endpoint }} endpoint-port={{ x.endpoint_port }} allowed-address={{ '0.0.0.0/0,::/0' if d.v6 else '0.0.0.0/0' }} persistent-keepalive=25s name="{{ x.peer_router }}"
{% endfor %}

/ip/address
{% for x in r.backbone %}
add address={{ x.address }} interface={{ x.iface }}
{% endfor %}
{% if d.v6 %}
/ipv6/address
{% for x in r.backbone %}
add address={{ x.address6 }} interface={{ x.iface }} advertise=no
{% endfor %}
{% endif %}
{% endif %}

{% if r.peers %}
# =====================================================================
#  EXTERNAL PEERS. These tunnels do NOT belong to AS{{ t.asn }}.
# =====================================================================
# The far end is a third party's router. Nobody here administers it, nobody
# here is told when it changes, and it's the only thing in this file that's
# true of neither the fleet nor a customer.
#
# Three things follow, and all three are enforced below rather than remembered:
#   - these interfaces go in `peer-tun`, which is NOT a member of `tunnels`.
#     The input chain accepts `tunnels` wholesale; a peer gets a narrow hole.
#   - they are in no `tun-*` list that OSPF names, so a peer can't join the
#     IGP, and the BFD menu is deny-by-default so it can't ask for a session.
#   - their BGP is a separate instance/chain set from the upstreams'.
/interface/wireguard
{% for x in r.peers if x.transport == 'wireguard' %}
add name={{ x.iface }} listen-port={{ x.listen_port }} mtu={{ x.mtu }} private-key="{{ x.private }}"
{% endfor %}

/interface/wireguard/peers
{% for x in r.peers if x.transport == 'wireguard' %}
# AS{{ x.asn }}{% if x.contact %}. {{ x.contact }}{% endif %}

add interface={{ x.iface }} public-key="{{ x.peer_public }}"{% if x.psk %} preshared-key="{{ x.psk }}"{% endif %}{% if x.endpoint %} endpoint-address={{ x.endpoint }} endpoint-port={{ x.endpoint_port }}{% endif %} allowed-address={{ x.allowed_address }}{% if x.endpoint %} persistent-keepalive=25s{% endif %} name="AS{{ x.asn }} {{ x.peer }}"
{% endfor %}

{% if r.peers | selectattr('v4') | list %}
/ip/address
{% for x in r.peers if x.v4 %}
# PEER-SUPPLIED. blocks: allocates all 256 addresses of {{ t.prefix }}; there's
# no v4 in this AS for a peering link, so this /31 is out of {{ x.peer }}'s space.
add address={{ x.v4.local }}/31 interface={{ x.iface }}
{% endfor %}
{% endif %}
{% if d.v6 %}
{% if r.peers | selectattr('v6') | list %}
/ipv6/address
{% for x in r.peers if x.v6 and x.v6.local %}
add address={{ x.v6.local }}/{{ x.v6.len }} interface={{ x.iface }} advertise=no
{% endfor %}
{% endif %}
{% endif %}

{% endif %}
# --- interface lists --------------------------------------------------
/interface/list
add name=tun-wan1
add name=tun-wan2
add name=tun-bb
{% if d.sites %}
add name=tun-site
{% endif %}
{% if r.peers %}
add name=peer-tun
{% endif %}
# >>> peer-tun IS NOT IN THIS LIST, AND THAT IS THE WHOLE POINT.
# >>> The input chain below accepts `in-interface-list=tunnels` wholesale.
# >>> every tunnel in it's a router this AS owns. Adding peer-tun here would
# >>> hand a third party the same unconditional accept, and would put their
# >>> interface in front of OSPF and BFD as well. Read the input chain before
# >>> you change this line.
{# Every firewall has a line like this. Ours just comes with a warning sign. #}
add name=tunnels include=tun-wan1,tun-wan2,tun-bb{% if d.sites %},tun-site{% endif %}

/interface/list/member
{% for x in r.tunnels %}
add list=tun-{{ x.link_class }} interface={{ x.iface }}
{% endfor %}
{% for x in r.backbone %}
add list=tun-bb interface={{ x.iface }}
{% endfor %}
{% for x in r.peers %}
add list=peer-tun interface={{ x.iface }}
{% endfor %}

{% if t.bfd.configure %}
# --- BFD: the fast liveness detector, UNDER OSPF ----------------------
# A config entry here does NOT start anything. It only says "a BFD session on
# this interface is permitted, and these are my timers". Sessions are created
# when a protocol asks for one (use-bfd on the OSPF templates below).
#
# THE DEFAULT IS DENY. RouterOS forbids BFD on every interface not listed in
# this menu, which is why ether1 is absent and needs no forbid rule: the
# upstream is an eBGP peer, not an OSPF neighbour, and it must never negotiate
# BFD with us. Entries are order-sensitive (first match wins); these three match
# disjoint interface lists, so the order is presentation only.
#
# min-tx/min-rx are one number per link class. Both ends run the same class, so
# splitting them would only create a way to mismatch them. And BFD negotiates
# max(local min-tx, remote min-rx) regardless.
#
# No firewall change is needed. BFD is UDP/3784 and every one of these
# interfaces is already covered by `in-interface-list=tunnels` in the input
# chain, in both families.
/routing/bfd/configuration
{% for cls, iflist in [('backbone', 'tun-bb'), ('wan1', 'tun-wan1'), ('wan2', 'tun-wan2')] + ([('site', 'tun-site')] if d.sites else []) %}
{% set b = t.bfd.links[cls] %}
add interfaces={{ iflist }} min-tx={{ b.interval }} min-rx={{ b.interval }} multiplier={{ b.multiplier }} comment="{{ cls }}: detect ~{{ b.detect_ms }}ms"
{% endfor %}

{% endif %}
# --- OSPF: loopbacks + tunnel /31s only -------------------------------
# WG interfaces never go down on their own. OSPF hellos are the ONLY
# liveness detector in this network.
{% if t.bfd.use_ospf %}
#
# ...except that BFD now sits underneath them. use-bfd=yes means the adjacency
# is torn on the BFD session's clock (hundreds of ms) instead of waiting out
# dead-interval. The hello/dead timers below are UNCHANGED on purpose: BFD is
# additive, so if a session fails to establish this router degrades to exactly
# the behaviour it had before BFD existed rather than to no detection at all.
{% endif %}
{% set bfd_on = ' use-bfd=yes' if t.bfd.use_ospf else '' %}
/routing/ospf/instance add name=core version=2 router-id={{ r.loopback }}
/routing/ospf/area add name=bb instance=core area-id=0.0.0.0
/routing/ospf/interface-template
add area=bb interfaces=lo0      passive
add area=bb interfaces=tun-bb   type=ptp cost={{ t.ospf_cost.backbone }} hello-interval=5s  dead-interval=20s{{ bfd_on }}
add area=bb interfaces=tun-wan1 type=ptp cost={{ t.ospf_cost.wan1 }} hello-interval=5s  dead-interval=20s{{ bfd_on }}
add area=bb interfaces=tun-wan2 type=ptp cost={{ t.ospf_cost.wan2 }} hello-interval=10s dead-interval=40s{{ bfd_on }}
{% if d.sites %}
# Sites cost {{ t.ospf_cost.site }} each way, deliberately more than the backbone ({{ t.ospf_cost.backbone }}).
# A site with a tunnel to every BR is a POSSIBLE BR<->BR transit path, and the
# cost is the only thing keeping a consumer uplink out of the inter-BR path
# while the backbone is healthy. It stays available as a last resort, which is
# the same trade the ER pair already carries.
add area=bb interfaces=tun-site type=ptp cost={{ t.ospf_cost.site }} hello-interval=5s  dead-interval=20s{{ bfd_on }}
{% endif %}
{% if d.v6 %}

# --- OSPFv3: a SEPARATE instance, same costs --------------------------
# router-id is {{ r.loopback }}. The v4 loopback, NOT the v6 one. An OSPFv3
# router-id is still a 32-bit value; it's an identifier, not an address, and
# there's nothing to derive it from in a v6-only world. Using the v4 loopback
# keeps the two instances legible as the same router in every LSA dump.
#
# The costs are IDENTICAL to OSPFv2 on purpose. If v4 and v6 preferred
# different WANs, a single link failure would move one family and not the
# other, and every failure would need debugging twice.
{% if t.bfd.use_ospf %}
#
# BFD is per-family too: OSPFv3 neighbours are link-local v6 addresses, so this
# instance builds its OWN BFD session over each tunnel alongside the v4 one. The
# /routing/bfd/configuration entries above are family-agnostic (they match on
# interface), so both sessions inherit the same class timers automatically.
# Which is the same reason the costs are duplicated verbatim.
{% endif %}
/routing/ospf/instance add name=core6 version=3 router-id={{ r.loopback }}
/routing/ospf/area add name=bb6 instance=core6 area-id=0.0.0.0
/routing/ospf/interface-template
add area=bb6 interfaces=lo0      passive
add area=bb6 interfaces=tun-bb   type=ptp cost={{ t.ospf_cost.backbone }} hello-interval=5s  dead-interval=20s{{ bfd_on }}
add area=bb6 interfaces=tun-wan1 type=ptp cost={{ t.ospf_cost.wan1 }} hello-interval=5s  dead-interval=20s{{ bfd_on }}
add area=bb6 interfaces=tun-wan2 type=ptp cost={{ t.ospf_cost.wan2 }} hello-interval=10s dead-interval=40s{{ bfd_on }}
{% if d.sites %}
add area=bb6 interfaces=tun-site type=ptp cost={{ t.ospf_cost.site }} hello-interval=5s  dead-interval=20s{{ bfd_on }}
{% endif %}
{% endif %}

# --- BGP instance: router-id lives HERE -------------------------------
# NOT on templates, NOT on connections. Instance also owns cluster-id,
# multipath (BGP ECMP) and vrf. Do NOT delete this menu. It's current,
# not legacy. Deleting it takes your router-id with it.
#
# multipath is BGP ECMP, and it's a COUNT, not a switch. The property is
# typed `num`. On a BR the equal-cost pair is the home {{ t.blocks.customer_home }}
# arriving from er1 AND er2 at the same IGP metric; without it the BR parks all
# inbound on whichever ER won a router-id tie-break.
#
# `multipath=yes` is a TYPE ERROR that aborts the import, and every /routing/bgp
# object below this line then never gets created. validate() refuses `true` for
# that reason. Written verbatim from topology.yml so a version difference is a
# one-line fix in one file, not a template change across three.
/routing/bgp/instance
add name=core as={{ t.asn }} router-id={{ r.loopback }}{% if t.bgp_multipath %} multipath={{ t.bgp_multipath }}{% endif %}


# --- leave the `default` template BARE --------------------------------
# A connection with no templates= inherits `default`. Anything policy-shaped
# left there gets silently inherited by a session that should never have had it.
/routing/bgp/template set default output.filter-chain="" output.network=""

# --- iBGP: FULL MESH, no route reflection -----------------------------
# Templates carry protocol/policy ONLY. No local.*, no remote.*, no router-id.
# On templates the address-family parameter is `afi` (it's `address-families`
# on connections: different menu, different name).
/routing/bgp/template
add name=ibgp afi=ip multihop=yes nexthop-choice=force-self \
    input.filter=ibgp-in output.filter-chain=ibgp-out

# local.address / local.role are CONNECTION-specific and can't be templated,
# so they repeat on every session.
#
# default-originate goes on DOWNSTREAM sessions ONLY. The ERs and the remote
# sites, both of which egress through us. RouterOS special-cases 0.0.0.0/0 on
# output: an eBGP-learned default is NOT propagated into iBGP unless you ask.
# But a BR must never hand a default to a SIBLING BR. That's what points a
# BR's tunnel-endpoint route back into the tunnel.
/routing/bgp/connection
{% for p in r.ibgp_peers %}
{% if p.role in ('er', 'sr') %}
add name=ibgp-{{ p.name }} instance=core templates=ibgp \
    local.address={{ r.loopback }} local.role=ibgp \
    remote.address={{ p.loopback }} remote.as={{ t.asn }} \
    output.default-originate=if-installed
{% else %}
add name=ibgp-{{ p.name }} instance=core templates=ibgp \
    local.address={{ r.loopback }} local.role=ibgp \
    remote.address={{ p.loopback }} remote.as={{ t.asn }}
{% endif %}
{% endfor %}

/routing/filter/rule
add chain=ibgp-in rule="accept"
# NEVER leak the aggregate into iBGP: every BR originates it locally.
add chain=ibgp-out rule="if (dst=={{ t.prefix }} && dst-len=={{ t.prefix.split('/')[1] }}) { reject }"
add chain=ibgp-out rule="accept"
{% if d.v6 %}

# --- iBGP v6: SEPARATE sessions over the v6 loopbacks -----------------
# Not the v6 AFI bolted onto the existing v4 sessions. Two reasons, both
# practical: nexthop-choice=force-self stays trivially correct (no RFC 5549
# v4-nexthop-for-v6-NLRI gymnastics), and the families fail independently. A
# v6 filter mistake can't take v4 iBGP down with it.
/routing/bgp/template
add name=ibgp6 afi=ipv6 multihop=yes nexthop-choice=force-self \
    input.filter=ibgp6-in output.filter-chain=ibgp6-out

/routing/bgp/connection
{% for p in r.ibgp_peers %}
{% if p.role in ('er', 'sr') %}
add name=ibgp6-{{ p.name }} instance=core templates=ibgp6 \
    local.address={{ r.loopback6 }} local.role=ibgp \
    remote.address={{ p.loopback6 }} remote.as={{ t.asn }} \
    output.default-originate=if-installed
{% else %}
add name=ibgp6-{{ p.name }} instance=core templates=ibgp6 \
    local.address={{ r.loopback6 }} local.role=ibgp \
    remote.address={{ p.loopback6 }} remote.as={{ t.asn }}
{% endif %}
{% endfor %}

/routing/filter/rule
add chain=ibgp6-in rule="accept"
# NEVER leak the aggregate into iBGP: every BR originates it locally.
add chain=ibgp6-out rule="if (dst=={{ t.aggregate_v6 }} && dst-len=={{ t.aggregate_v6.split('/')[1] }}) { reject }"
add chain=ibgp6-out rule="accept"
{% endif %}

# --- eBGP upstream ----------------------------------------------------
# Name + filter-chain identical on every BR; only the chain CONTENTS differ.
# local.address is MANDATORY: without it RouterOS guesses and prefers the
# highest loopback, which isn't what the provider expects.
/routing/bgp/template
add name=ebgp-up afi=ip multihop=yes \
    output.network=my-aggregate \
    output.network-blackhole=no \
    input.filter=ebgp-in output.filter-chain=ebgp-out-upstream

# output.network is documented as: "the network is sent only if a matching
# route exists in the routing table". That's EXACTLY what makes the anchor
# route the origination switch. network-blackhole=no is what stops RouterOS
# from creating its own blackhole and making anchor-guard a no-op.
/routing/bgp/connection
add name=ebgp-upstream instance=core templates=ebgp-up \
    local.address={{ r.wan_address }} local.role=ebgp \
    remote.address={{ r.peer_address }}/32 remote.as={{ r.peer_asn }} \
    tcp-md5-key="{{ r.bgp_auth_key }}" \
    listen=yes connect=yes

/routing/filter/rule
add chain=ebgp-in rule="if (dst==0.0.0.0/0 && dst-len==0) { accept } reject"

# input.filter isn't enough on its own: MikroTik is explicit that a regular
# input filter "can only reject prefixes... it will still eat memory and will
# be visible in /routing route table as 'not active, filtered'." A provider
# sending a full table (Vultr does) would park ~1M discarded routes in RAM on a
# small CHR. filter-nlri drops them BEFORE they are stored.
# NOTE: changing this needs a session RESTART, not a refresh.
add chain=ebgp-nlri rule="if (dst==0.0.0.0/0 && dst-len==0) { accept } reject"
/routing/bgp/template set [find name=ebgp-up] input.filter-nlri=ebgp-nlri

# --- ebgp-out-upstream: the ONLY per-BR chain -------------------------
{% if r.upstream_communities %}
# {{ r.provider }} requires: {{ r.upstream_communities | join(', ') }}
add chain=ebgp-out-upstream rule="set bgp-communities {{ r.upstream_communities | join(',') }}"
{% endif %}
{% if r.te_prepend %}
# INGRESS TE: {{ r.provider }} is a BACKUP way INTO AS{{ t.asn }}. The aggregate leaves
# here with {{ r.te_prepend }} extra copies of {{ t.asn }} in the AS_PATH, so a DFZ router with
# a choice takes the other BR. This is a HINT, never a guarantee. A network
# whose own local-pref policy prefers {{ r.provider }} never looks at path length.
#
# Scoped to the aggregate, NOT put at the head of the chain: a bare `set` here
# would also prepend RTBH /32s, and a blackhole request wants the SHORTEST path
# to the upstream. Its 65535:666 is what stops the traffic, not distance.
#
# It sits BEFORE the {{ t.asn }}:2:N ladder on purpose. `set bgp-path-prepend`
# ASSIGNS, it doesn't add, so the last rule to run is the one that ships.
# Which keeps the runtime community override able to out-vote topology.yml
# without a regenerate-and-redeploy.
add chain=ebgp-out-upstream rule="if (dst=={{ t.prefix }} && dst-len=={{ t.prefix.split('/')[1] }}) { set bgp-path-prepend {{ r.te_prepend }} }"
{% endif %}
add chain=ebgp-out-upstream rule="if (bgp-large-communities includes {{ t.asn }}:3:{{ r.peer_asn }}) { reject }"
add chain=ebgp-out-upstream rule="if (bgp-large-communities includes {{ t.asn }}:2:3) { set bgp-path-prepend 3 }"
add chain=ebgp-out-upstream rule="if (bgp-large-communities includes {{ t.asn }}:2:2) { set bgp-path-prepend 2 }"
add chain=ebgp-out-upstream rule="if (bgp-large-communities includes {{ t.asn }}:2:1) { set bgp-path-prepend 1 }"
add chain=ebgp-out-upstream rule="jump ebgp-out"

# --- ebgp-out: shared tail. RTBH, strip internals, terminal reject. ---
{% set rtbh_comms = (r.upstream_communities + ['65535:666', 'no-export']) | join(',') %}
{% if r.upstream_communities %}
# `set bgp-communities` REPLACES, it doesn't append. So the RTBH rule below
# must re-state {{ r.upstream_communities | join(',') }} or it would wipe it.
# And the blackhole would never clear {{ r.provider }}'s scrubbing platform,
# i.e. RTBH would silently fail on exactly the provider it matters most for.
{% endif %}
add chain=ebgp-out rule="if (dst in {{ t.prefix }} && dst-len==32 && bgp-large-communities includes {{ t.asn }}:1:666) { delete bgp-large-communities all; set bgp-communities {{ rtbh_comms }}; accept }"
add chain=ebgp-out rule="if (dst=={{ t.prefix }} && dst-len=={{ t.prefix.split('/')[1] }}) { delete bgp-large-communities all; accept }"
# Terminal reject: stops an untagged more-specific ever leaking upstream.
add chain=ebgp-out rule="reject"
{% if d.v6 %}

# =====================================================================
#  eBGP v6 upstream: a second, independent session to {{ r.provider }}
# =====================================================================
# local.address is the WAN v6 address, exactly as the v4 session uses the WAN
# v4 address. Same ASN ({{ r.peer_asn }}) and same MD5 key as v4: this is one
# peering relationship carrying two families over two sessions.
/routing/bgp/template
add name=ebgp6-up afi=ipv6 multihop=yes \
    output.network=my-aggregate6 \
    output.network-blackhole=no \
    input.filter=ebgp6-in output.filter-chain=ebgp6-out-upstream

/routing/bgp/connection
add name=ebgp6-upstream instance=core templates=ebgp6-up \
    local.address={{ r.wan_v6.address }} local.role=ebgp \
    remote.address={{ r.peer_v6_address }}/128 remote.as={{ r.peer_asn }} \
    tcp-md5-key="{{ r.bgp_auth_key }}" \
    listen=yes connect=yes

/routing/filter/rule
add chain=ebgp6-in rule="if (dst==::/0 && dst-len==0) { accept } reject"
# Same reasoning as the v4 filter-nlri: reject BEFORE storing, or a full v6
# table (~200k routes and growing) sits in RAM as "not active, filtered" on a
# CHR that doesn't have the memory to spare.
add chain=ebgp6-nlri rule="if (dst==::/0 && dst-len==0) { accept } reject"
/routing/bgp/template set [find name=ebgp6-up] input.filter-nlri=ebgp6-nlri

{% if r.upstream_communities %}
# {{ r.provider }} requires: {{ r.upstream_communities | join(', ') }}
add chain=ebgp6-out-upstream rule="set bgp-communities {{ r.upstream_communities | join(',') }}"
{% endif %}
{% if r.te_prepend %}
# Same {{ r.te_prepend }} prepends, same reasoning, matched on the ANNOUNCED v6 aggregate
# ({{ t.aggregate_v6 }}). Not prefix_v6, which is the allocation and is never
# advertised. The two families must carry the same policy or one moves and the
# other doesn't, which is the hardest kind of TE change to see.
add chain=ebgp6-out-upstream rule="if (dst=={{ t.aggregate_v6 }} && dst-len=={{ t.aggregate_v6.split('/')[1] }}) { set bgp-path-prepend {{ r.te_prepend }} }"
{% endif %}
add chain=ebgp6-out-upstream rule="if (bgp-large-communities includes {{ t.asn }}:3:{{ r.peer_asn }}) { reject }"
add chain=ebgp6-out-upstream rule="if (bgp-large-communities includes {{ t.asn }}:2:3) { set bgp-path-prepend 3 }"
add chain=ebgp6-out-upstream rule="if (bgp-large-communities includes {{ t.asn }}:2:2) { set bgp-path-prepend 2 }"
add chain=ebgp6-out-upstream rule="if (bgp-large-communities includes {{ t.asn }}:2:1) { set bgp-path-prepend 1 }"
add chain=ebgp6-out-upstream rule="jump ebgp6-out"

# RTBH is a /128 here, not a /32. The v6 host route. Everything else about
# the chain is the v4 chain unchanged.
add chain=ebgp6-out rule="if (dst in {{ t.aggregate_v6 }} && dst-len==128 && bgp-large-communities includes {{ t.asn }}:1:666) { delete bgp-large-communities all; set bgp-communities {{ rtbh_comms }}; accept }"
add chain=ebgp6-out rule="if (dst=={{ t.aggregate_v6 }} && dst-len=={{ t.aggregate_v6.split('/')[1] }}) { delete bgp-large-communities all; accept }"
add chain=ebgp6-out rule="reject"
{% endif %}

# --- input filter. The forward chain stays EMPTY. ---------------------
/ip/firewall/filter
add chain=input action=accept connection-state=established,related
add chain=input action=accept protocol=icmp comment="PMTUD/QUIC - never break this"
add chain=input action=accept protocol=udp dst-port={{ r.tunnels | map(attribute='listen_port') | sort | join(',') }} comment="WG to ERs{% if d.sites %} + sites{% endif %}"
{% if r.backbone %}
add chain=input action=accept protocol=udp dst-port={{ r.backbone | map(attribute='listen_port') | sort | join(',') }} comment="WG backbone"
{% endif %}
add chain=input action=accept protocol=tcp dst-port=179 src-address={{ r.peer_address }}
add chain=input action=accept in-interface-list=tunnels comment="WG-authenticated"
{% if r.peers %}
# --- external peers. NARROWER than the rule above, deliberately. -------
# There's no `accept in-interface-list=peer-tun` here and there must never be
# one: that list is a third party's router. Each rule below opens exactly one
# thing to exactly one source.
#
# These CAN pin a source address where the ER-facing rule can't. The ERs
# dial out from a CGNAT address that moves, but a peer's endpoint is a fixed
# fact they gave us, and it's already pinned as a /32 in the recursion guards.
{% for x in r.peers if x.transport == 'wireguard' and x.endpoint %}
add chain=input action=accept protocol=udp dst-port={{ x.listen_port }} src-address={{ x.endpoint }} comment="WG peer {{ x.peer }} (AS{{ x.asn }})"
{% endfor %}
{% for x in r.peers if x.transport == 'wireguard' and not x.endpoint %}
# {{ x.peer }} dials US and gave no endpoint, so this one can't be source-pinned.
add chain=input action=accept protocol=udp dst-port={{ x.listen_port }} comment="WG peer {{ x.peer }} (AS{{ x.asn }}), inbound-only"
{% endfor %}
{% for x in r.peers if 4 in x.families %}
# BGP pinned to the INTERFACE, not an address: that's what lets a session with
# link-local or peer-numbered addressing be expressed without naming one.
add chain=input action=accept protocol=tcp dst-port=179 in-interface={{ x.iface }} comment="eBGP peer {{ x.peer }}"
{% endfor %}
{% endif %}
{% if t.snmp is defined and t.snmp and t.snmp.enabled %}
# SNMPv3 polling, and ONLY that. This is the rule the WAN case depends on: a
# poller reaching this BR over a tunnel is already covered by the accept above,
# but one polling the public address isn't, and neither is one that arrives
# after the tunnels are down. Which is exactly when you want the router to
# still answer. udp/161 from the poller and nothing else; authPriv is what
# decides whether the answer is useful.
add chain=input action=accept protocol=udp dst-port=161 src-address-list=snmp comment="SNMPv3 poller"
{% endif %}
add chain=input action=accept src-address-list=mgmt
add chain=input action=drop
{% if r.peers %}

# --- forward: the ONE rule that belongs here ---------------------------
# The forward chain on a BR has always been empty, and the reason was never
# "forwarding needs no policy": it was that every tunnel on the box belonged
# to this AS, so there was nothing to filter. A peer tunnel breaks that
# assumption: the far end can put any source address it likes on a packet, and
# with an empty forward chain this router would route it.
#
# So: anything arriving from a peer claiming to BE us is dropped. That's
# BCP38 applied at the one edge where it was previously unnecessary, and it's
# deliberately the ONLY rule here. A general-purpose forward policy on a
# transit router is a different change with a much larger blast radius.
add chain=forward action=drop in-interface-list=peer-tun src-address={{ t.prefix }} comment="BCP38: a peer may not source from our own space"
{% endif %}
{% if d.v6 %}

/ipv6/firewall/filter
add chain=input action=accept connection-state=established,related
{% if r.wan_v6.gateway | lower == 'ra' %}
# THIS RULE IS WHAT MAKES accept-router-advertisements=yes SAFE.
# That setting is global, so without this a peer at the far end of a WireGuard
# tunnel could send an RA and install itself as this BR's default gateway.
# It must sit ABOVE the blanket ICMPv6 accept below, or the accept wins.
#
# >>> IT MUST COVER EVERY TUNNEL LIST, NOT JUST `tunnels`. When this rule was
# >>> written, `tunnels` WAS every tunnel on the box, so naming it was the same
# >>> as naming all of them. peer-tun is the first list that isn't in it. And
# >>> it's the untrusted one, so a peer-tun that this rule didn't cover would
# >>> be a hole in exactly the property the rule exists to provide, opened by
# >>> the change that added the least trusted interface on the router.
add chain=input action=drop protocol=icmpv6 icmp-options=134:0 in-interface-list=tunnels comment="no RAs from tunnels"
{% if r.peers %}
add chain=input action=drop protocol=icmpv6 icmp-options=134:0 in-interface-list=peer-tun comment="no RAs from peers"
{% endif %}
{% endif %}
# ICMPv6 is NOT optional the way ICMP is in v4. Neighbour Discovery replaces
# ARP, and PMTUD has no fragmentation fallback. Drop this and the tunnels
# blackhole large packets while ping still works. Never narrow this to echo.
add chain=input action=accept protocol=icmpv6 comment="ND + PMTUD - never break this"
add chain=input action=accept protocol=tcp dst-port=179 src-address={{ r.peer_v6_address }} comment="eBGP v6 upstream"
add chain=input action=accept in-interface-list=tunnels comment="WG-authenticated"
{% if r.peers %}
# Again: no blanket accept for peer-tun. One rule, one session, per interface.
{% for x in r.peers if 6 in x.families %}
add chain=input action=accept protocol=tcp dst-port=179 in-interface={{ x.iface }} comment="eBGP6 peer {{ x.peer }}"
{% endfor %}
{% endif %}
# NOTE: there's deliberately no v6 mgmt accept. mgmt_prefixes
# ({{ t.mgmt_prefixes | join(', ') }}) is v4-only (generate.py rejects a v6
# entry outright) so management SSH stays on v4 and this chain has no
# equivalent hole. Add a v6 mgmt list to topology.yml AND a matching accept
# here before trying to SSH in over v6.
add chain=input action=drop
{% endif %}

# --- anchor-guard: two signals, two timers ---------------------------
# Slow to withdraw (a flapping adjacency must not become a DFZ event),
# instant to re-originate.
{% if t.origination.mode == 'home' %}
#
# ORIGINATION MODE: home. The customer signal is NOT "any customer prefix".
# It's "the home {{ t.blocks.customer_home }} reaches me over one of MY OWN tunnels
# to the ERs" ({{ r.home_tunnels | join(', ') }}). A /25 that resolves
# through the backbone doesn't count. So disabling er1's and er2's tunnels to
# {{ r.name }} withdraws {{ t.prefix }} from {{ r.provider }} after ~{{ t.origination.cust_ticks * 10 }}s,
# while the sibling BR keeps announcing. The trade: a home outage withdraws the
# aggregate from EVERY BR, and a remote site can't hold it up.
{% endif %}
/system/script
add name=anchor-guard policy=read,write,test source={
  :global agIsoFail
  :global agCustFail
  :global agCustFail6
  :if ([:typeof $agIsoFail]   = "nothing") do={ :set agIsoFail   0 }
  :if ([:typeof $agCustFail]  = "nothing") do={ :set agCustFail  0 }
  :if ([:typeof $agCustFail6] = "nothing") do={ :set agCustFail6 0 }

  :local peers { {% for p in r.guard_peers %}"{{ p }}"{% if not loop.last %}; {% endif %}{% endfor %} }
  :local reachable 0
  :foreach p in=$peers do={
    :if ([:len [/ip/route/find where dst-address=("$p/32") && active]] > 0) do={
      :set reachable ($reachable + 1)
    }
  }

  # `!blackhole`, NOT `blackhole=no`. On a route that isn't a blackhole the
  # property is UNSET rather than set to `no`, so `blackhole=no` matches
  # nothing: including the perfectly healthy iBGP-learned {{ t.blocks.customer_home }}
  # this loop exists to find. Verified on 7.24: with the /25 delivered by both
  # edge routers, `... && active && blackhole=no` returns 0 and
  # `... && active && !blackhole` returns 2.
  #
  # That made `delivered` permanently 0, so agCustFail climbed on every run and
  # this guard withdrew {{ t.prefix }} sixty ticks later. The exact outage it
  # is here to prevent, caused by the guard itself. It went unnoticed because
  # the scheduler below ships commented out.
{% if t.origination.mode == 'home' %}
  #
  # HOME MODE: count the ER tunnels the /25 actually leaves through.
  # immediate-gw is the RESOLVED next hop, "<addr>%<interface>", so an iBGP
  # route whose ER loopback is reached over the backbone reads %wg-<sibling>
  # here and isn't counted. `delivered` is the number of this BR's own home
  # tunnels carrying it; 0 means home is reachable only through a sibling, or
  # not at all.
  :local hometun { {% for i in r.home_tunnels %}"{{ i }}"{% if not loop.last %}; {% endif %}{% endfor %} }
  :local delivered 0
  :foreach i in=$hometun do={
    :if ([:len [/ip/route/find where dst-address="{{ t.blocks.customer_home }}" && active && !blackhole && immediate-gw~("%$i")]] > 0) do={
      :set delivered ($delivered + 1)
    }
  }
{% else %}
  :local customers { "{{ t.blocks.customer_home }}"{% for s in t.sites %}; "{{ s.delegation }}"{% endfor %} }
  :local delivered 0
  :foreach c in=$customers do={
    :if ([:len [/ip/route/find where dst-address=$c && active && !blackhole]] > 0) do={
      :set delivered ($delivered + 1)
    }
  }
{% endif %}

{% if d.v6 %}
  # The customer signal is evaluated PER FAMILY. Isolation isn't: both families
  # ride the same WireGuard tunnels and the same OSPF adjacencies, so if this BR
  # can reach no sibling in v4 it can't in v6 either. One signal, one answer.
  #
  # The customer signal genuinely differs, though. A live v6 customer must NOT
  # hold up {{ t.prefix }}: continuing to announce a v4 aggregate that no v4
  # customer can be delivered through is precisely the black hole this guard
  # exists to stop. So each aggregate is withdrawn on its own family's evidence.
{% if t.origination.mode == 'home' %}
  # Same tunnels, v6 evidence. OSPFv3 next hops are link-local, so immediate-gw
  # reads "fe80::...%wg-er1-wan1". The interface suffix is what is matched.
  :local delivered6 0
  :foreach i in=$hometun do={
    :if ([:len [/ipv6/route/find where dst-address="{{ t.blocks_v6.customer_home }}" && active && !blackhole && immediate-gw~("%$i")]] > 0) do={
      :set delivered6 ($delivered6 + 1)
    }
  }
{% else %}
  :local customers6 { "{{ t.blocks_v6.customer_home }}"{% for s in t.sites %}; "{{ s.delegation6 }}"{% endfor %} }
  :local delivered6 0
  :foreach c in=$customers6 do={
    :if ([:len [/ipv6/route/find where dst-address=$c && active && !blackhole]] > 0) do={
      :set delivered6 ($delivered6 + 1)
    }
  }
{% endif %}
{% endif %}

  :if ($reachable > 0) do={ :set agIsoFail  0 } else={ :set agIsoFail  ($agIsoFail  + 1) }
  :if ($delivered > 0) do={ :set agCustFail 0 } else={ :set agCustFail ($agCustFail + 1) }
{% if d.v6 %}
  :if ($delivered6 > 0) do={ :set agCustFail6 0 } else={ :set agCustFail6 ($agCustFail6 + 1) }
{% endif %}

  :local pull false
  :if ($agIsoFail  >= 6)  do={ :set pull true }
  :if ($agCustFail >= {{ t.origination.cust_ticks }}) do={ :set pull true }

  :local down [/ip/route/find where comment="anchor" && disabled=yes]
  :if ($pull) do={
    :if ([:len $down] = 0) do={
      /ip/route/set [find where comment="anchor"] disabled=yes
      :log error ("anchor-guard: WITHDRAWING {{ t.prefix }} reachable=$reachable delivered=$delivered")
    }
  } else={
    :if ([:len $down] > 0) do={
      /ip/route/set [find where comment="anchor"] disabled=no
      :log warning ("anchor-guard: RE-ORIGINATING {{ t.prefix }} reachable=$reachable delivered=$delivered")
    }
  }
{% if d.v6 %}

  :local pull6 false
  :if ($agIsoFail   >= 6)  do={ :set pull6 true }
  :if ($agCustFail6 >= {{ t.origination.cust_ticks }}) do={ :set pull6 true }

  :local down6 [/ipv6/route/find where comment="anchor6" && disabled=yes]
  :if ($pull6) do={
    :if ([:len $down6] = 0) do={
      /ipv6/route/set [find where comment="anchor6"] disabled=yes
      :log error ("anchor-guard: WITHDRAWING {{ t.aggregate_v6 }} reachable=$reachable delivered6=$delivered6")
    }
  } else={
    :if ([:len $down6] > 0) do={
      /ipv6/route/set [find where comment="anchor6"] disabled=no
      :log warning ("anchor-guard: RE-ORIGINATING {{ t.aggregate_v6 }} reachable=$reachable delivered6=$delivered6")
    }
  }
{% endif %}
}

# Enable ONLY after proving the anchor actually gates origination. Note
# keep-sent-attributes defaults to `no`, so advertisements/print returns an
# EMPTY list regardless: turn it on first or you will test nothing:
#   /routing/bgp/connection set [find name=ebgp-upstream] output.keep-sent-attributes=yes
#   /ip/route/disable [find comment="anchor"]
#   /routing/bgp/advertisements/print peer=ebgp-upstream   <- must be EMPTY
#   /ip/route/enable  [find comment="anchor"]
#   /routing/bgp/advertisements/print peer=ebgp-upstream   <- must show the /24
#   /routing/bgp/connection set [find name=ebgp-upstream] output.keep-sent-attributes=no
#
{% if t.origination.mode == 'home' %}
# HOME MODE has a second thing to prove: that immediate-gw tells a direct
# tunnel from the backbone. Neither the property nor its "<addr>%<iface>" form
# has been checked on a live box in this fleet. Before arm_guard: true.
#   /ip/route/print where dst-address={{ t.blocks.customer_home }} && active && immediate-gw~"%wg-er"
#     <- must list at least one route
#   then on er1 AND er2:  /interface/wireguard/disable [find name~"^wg-{{ r.name }}-"]
#   /ip/route/print where dst-address={{ t.blocks.customer_home }} && active && immediate-gw~"%wg-er"
#     <- must be EMPTY, while the /25 is still present via the backbone
#   on er1 AND er2:       /interface/wireguard/enable [find name~"^wg-{{ r.name }}-"]
# If the first print is empty with the tunnels UP, this guard would withdraw
# {{ t.prefix }} from every BR {{ t.origination.cust_ticks * 10 }}s after arming. Don't arm it.
{% elif d.sites %}
# THE PRECONDITION IS NOW MET, and this is the moment to revisit arming it.
# The customers list above is no longer a single entry: {{ d.sites | length }} remote site(s)
# ({{ d.sites | map(attribute='delegation') | join(', ') }}) can hold {{ t.prefix }} up while
# home is dark, which is the whole reason the guard tests "any customer prefix"
# rather than "home". Prove the site's /29 actually shows up here as an active,
# non-blackhole route BEFORE uncommenting: on this BR:
#   /ip/route/print where dst-address={{ d.sites[0].delegation }} && active
{% else %}
# STILL DISABLED, deliberately: not just "unproven". With sites: [] the
# customers list below is a single entry ({{ t.blocks.customer_home }}), so the
# "any customer prefix" generalisation has nothing to generalise over: losing
# home IS losing every customer. Arming this today means a >10min home outage
# withdraws {{ t.prefix }} from the DFZ. That trade only makes sense once home
# has a genuinely independent second path (wan2 is currently wired to a dummy
# router, so all four ER tunnels share wan1) or a remote site is live to hold
# the prefix up. Revisit when either is true.
{% endif %}
{% if t.origination.arm_guard %}
# ARMED from topology.yml (origination.arm_guard: true).
/system/scheduler add name=anchor-guard interval=10s on-event=anchor-guard policy=read,write,test
{% else %}
# Arm it with origination.arm_guard: true in topology.yml, not by hand: a
# scheduler pasted onto the box is gone after the next reset-configuration deploy.
# /system/scheduler add name=anchor-guard interval=10s on-event=anchor-guard policy=read,write,test
{% endif %}

# =====================================================================
#  default-guard: stop advertising a default when eBGP is DOWN.
# =====================================================================
# The provider default sits at distance {{ t.provider_default_distance }} and is therefore ALWAYS
# installed. So `if-installed` is always satisfied. And a BR with a dead eBGP
# session would keep handing a default to the ERs. They would send it traffic
# sourced from {{ t.prefix }}, which {{ r.provider }} drops at their BCP38 filter,
# because we're no longer announcing the prefix to them. Silent black hole.
#
# Gate on the SESSION, not on route presence. Route presence can't distinguish
# "upstream gave me a default" from "I have a static fallback".
#
# Separate actuator from anchor-guard (which owns only the anchor ROUTE), so the
# two never fight over the same object.
#
# The downstream sessions are ENUMERATED, not matched by a pattern. They used to
# be found with name~"^ibgp-er", which stopped covering the fleet the moment a
# remote site existed: a site's session is named for its site code, and no regex
# over role names can match that. The failure mode was the exact one this script
# exists to prevent, at the router least able to notice it. A site would keep
# being offered a default by a BR whose eBGP was dead, and would send it traffic
# that dies at the upstream's BCP38 filter.
/system/script
add name=default-guard policy=read,write,test source={
  :local dn { {% for p in r.ibgp_peers if p.role in ('er', 'sr') %}"ibgp-{{ p.name }}"{% if not loop.last %}; {% endif %}{% endfor %} }
  :local up [:len [/routing/bgp/session/find where name~"^ebgp-upstream" && established]]
  :local mode "never"
  :if ($up > 0) do={ :set mode "if-installed" }
  :foreach n in=$dn do={
    :foreach c in=[/routing/bgp/connection/find where name=$n] do={
      :if ([/routing/bgp/connection/get $c output.default-originate] != $mode) do={
        /routing/bgp/connection/set $c output.default-originate=$mode
        :log warning ("default-guard: eBGP up=$up -> $n default-originate=$mode")
      }
    }
  }
{% if d.v6 %}

  # Gated on the v6 session SEPARATELY. If v6 eBGP is down but v4 is up, the
  # downstreams must stop being told this BR has a v6 default while still using
  # it for v4: a single combined signal would either strand v4 or black-hole
  # v6.
  #
  # The session match stays ^-anchored so "ebgp-upstream" can't also match
  # "ebgp6-upstream"; the connection names are exact, so the families can't
  # drive each other at all.
  :local dn6 { {% for p in r.ibgp_peers if p.role in ('er', 'sr') %}"ibgp6-{{ p.name }}"{% if not loop.last %}; {% endif %}{% endfor %} }
  :local up6 [:len [/routing/bgp/session/find where name~"^ebgp6-upstream" && established]]
  :local mode6 "never"
  :if ($up6 > 0) do={ :set mode6 "if-installed" }
  :foreach n in=$dn6 do={
    :foreach c in=[/routing/bgp/connection/find where name=$n] do={
      :if ([/routing/bgp/connection/get $c output.default-originate] != $mode6) do={
        /routing/bgp/connection/set $c output.default-originate=$mode6
        :log warning ("default-guard: eBGP6 up=$up6 -> $n default-originate=$mode6")
      }
    }
  }
{% endif %}
}

# Test it honestly before trusting it:
#   /routing/bgp/connection/disable [find name=ebgp-upstream]
#   ... on an ER:  /routing/route/print where dst-address=0.0.0.0/0
#   this BR's default must disappear within ~10s.
/system/scheduler add name=default-guard interval=10s on-event=default-guard policy=read,write,test

{% if r.peers %}
# =====================================================================
#  EXTERNAL PEERING. Rendered LAST on purpose.
# =====================================================================
# _mgmt.j2 is first in this file and _snmp.j2 is last, both because a line
# RouterOS rejects costs you everything BELOW it on a box reset-configuration
# has already wiped. This block sits at the bottom for the same reason: it's
# the newest construct on the router, so a rejection here costs peering and
# monitoring, and never transit, never the {{ t.prefix }} origination, never SSH.
#
# `local.role=ebgp` and NOT `ebgp-peer`. RFC 9234 has a role that describes
# this relationship exactly, and RouterOS may well accept it. But no box in
# this fleet has ever executed that value, and the deploy path doesn't offer a
# second chance. The filter chains below are the actual settlement-free
# control; the role would be a belt on top of braces. Verify it on a live box,
# then change this one word.
#
# NO multihop: every session here rides its own tunnel and the far end is the
# other address of the link. The upstreams need multihop=yes because
# 169.254.169.254 isn't on their WAN subnet; a /127 on a WireGuard interface
# is directly connected by construction.

# --- what we ANNOUNCE, per realm. Terminal reject = never transit. -----
# This chain is the whole settlement-free promise, and it's a whitelist: a
# route learned from one peer can't reach another peer or an upstream, because
# nothing but our own aggregate ever passes. Same shape as ebgp-out above,
# which already protects the upstreams today.
/routing/filter/rule
add chain=peer-out-internet rule="if (dst=={{ t.prefix }} && dst-len=={{ t.prefix.split('/')[1] }}) { delete bgp-large-communities all; accept }"
add chain=peer-out-internet rule="reject"
{% if d.v6 %}
add chain=peer6-out-internet rule="if (dst=={{ t.aggregate_v6 }} && dst-len=={{ t.aggregate_v6.split('/')[1] }}) { delete bgp-large-communities all; accept }"
add chain=peer6-out-internet rule="reject"
{% endif %}

{% for x in r.peers %}
# --- {{ x.peer }} (AS{{ x.asn }}, realm {{ x.realm }}){% if x.contact %}. {{ x.contact }}{% endif %} ----------------
{% if 4 in x.families %}
# PRE-STORAGE. input.filter alone only marks a route "not active, filtered".
# It still occupies RAM on a CHR. filter-nlri drops it before it's stored.
# Changing this needs a session RESTART, which on this deploy path is academic:
# every apply is a cold start.
add chain={{ x.chains.nlri }} rule="if (dst-len==0) { reject }"
add chain={{ x.chains.nlri }} rule="if (dst in {{ t.prefix }}) { reject }"
{% for c in x.claims %}
add chain={{ x.chains.nlri }} rule="if ({{ c.match }}) { accept }"
{% endfor %}
add chain={{ x.chains.nlri }} rule="reject"
# local-pref 150: a peer is preferred over transit, which is the entire reason
# to have one. It's NOT a te.local_pref value. Those are stamped by the ERs
# on the DEFAULT they hear over iBGP, in a different direction on a different
# router. The number only has to beat the 100 an eBGP-learned route gets here.
#
# And that preference is exactly why the dst-len==0 reject above is the most
# important line in this chain: a peer sending a default at 150 would beat
# the provider default and take every packet of egress with it.
add chain={{ x.chains.in }} rule="set bgp-local-pref 150; accept"
add chain={{ x.chains.out }} rule="jump peer-out-internet"

/routing/bgp/template
add name={{ x.session }} afi=ip \
    output.network=my-aggregate \
    output.network-blackhole=no \
    input.filter={{ x.chains.in }} output.filter-chain={{ x.chains.out }}
/routing/bgp/template set [find name={{ x.session }}] input.filter-nlri={{ x.chains.nlri }}

/routing/bgp/connection
add name={{ x.session }} instance={{ x.instance }} templates={{ x.session }} \
    local.address={{ x.v4.local }} local.role=ebgp \
    remote.address={{ x.v4.remote }}/32 remote.as={{ x.asn }} \
{% if x.md5 %}    tcp-md5-key="{{ x.md5 }}" \
{% endif %}    input.limit-process-routes-ipv4={{ x.max_routes }} \
    listen=yes connect=yes

/routing/filter/rule
{% endif %}
{% if d.v6 and 6 in x.families %}
add chain={{ x.chains.nlri6 }} rule="if (dst-len==0) { reject }"
add chain={{ x.chains.nlri6 }} rule="if (dst in {{ t.aggregate_v6 }}) { reject }"
{% for c in x.claims6 %}
add chain={{ x.chains.nlri6 }} rule="if ({{ c.match }}) { accept }"
{% endfor %}
add chain={{ x.chains.nlri6 }} rule="reject"
add chain={{ x.chains.in6 }} rule="set bgp-local-pref 150; accept"
add chain={{ x.chains.out6 }} rule="jump peer6-out-internet"

/routing/bgp/template
add name={{ x.session6 }} afi=ipv6 \
    output.network=my-aggregate6 \
    output.network-blackhole=no \
    input.filter={{ x.chains.in6 }} output.filter-chain={{ x.chains.out6 }}
/routing/bgp/template set [find name={{ x.session6 }}] input.filter-nlri={{ x.chains.nlri6 }}

/routing/bgp/connection
add name={{ x.session6 }} instance={{ x.instance }} templates={{ x.session6 }} \
    local.address={{ x.v6.local }} local.role=ebgp \
    remote.address={{ x.v6.remote }}/128 remote.as={{ x.asn }} \
{% if x.md5 %}    tcp-md5-key="{{ x.md5 }}" \
{% endif %}    input.limit-process-routes-ipv6={{ x.max_routes_v6 }} \
    listen=yes connect=yes

/routing/filter/rule
{% endif %}
{% endfor %}
{% endif %}

{% include '_snmp.j2' %}
