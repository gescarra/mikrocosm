# =====================================================================
#  {{ r.fqdn }} (Remote site router · AS{{ t.asn }}
#  GENERATED by generate.py from topology.yml) DO NOT EDIT BY HAND.
#  CONTAINS PRIVATE KEYS. Don't commit.
# =====================================================================
#  ONE BOX, TUNNELS TO EVERY BR. A site router is a consolidated edge
#  router: it does alone what er1+er2 do as a pair at hdc. There's no
#  primary/backup BR pinning: it dials all {{ d.brs | length }} of them, joins the full
#  iBGP mesh, and lets OSPF cost decide the path. Losing one BR costs a
#  reconvergence and nothing else.
{# A hAP doing the job of two routers. Pay it in compliments. #}
#
#  IT IS ALSO THE SITE'S WAN ROUTER. {{ r.delegation }} is ATTACHED here,
#  not routed onward to a firewall: this device holds {{ r.lan_gateway }}
#  as the inside default gateway and the other addresses in the /29 are
#  the site's to use, routed directly with NO NAT. There's no eBGP
#  customer session at a site and no VIP claims. That machinery exists
#  at hdc because hdc has firewalls claiming space out of a shared /25.
#
#  >>> THIS ROUTER DOES NOT FIREWALL THE SITE. The forward chain is empty,
#  >>> exactly as it's on every other router in this AS, and the /29 and
#  >>> the site /64 are PUBLICLY ROUTABLE. At hdc that job belongs to
#  >>> pfSense; here it belongs to whatever the inside device is. Anything
#  >>> plugged into {{ r.lan_interfaces | join('/') }} is on the internet.
# =====================================================================
{% set wan = r.wans[0] %}
{% set bfd_on = ' use-bfd=yes' if t.bfd.use_ospf else '' %}

/system/identity set name={{ r.fqdn }}

{% include '_mgmt.j2' %}

/interface/bridge add name=lo0 protocol-mode=none
/ip/address add address={{ r.loopback }}/32 interface=lo0
{% if d.v6 %}
/ipv6/address add address={{ r.loopback6 }}/128 interface=lo0 advertise=no
{% endif %}

/ip/firewall/connection/tracking set enabled=yes
/ip/firewall/raw
add chain=prerouting action=notrack dst-address-type=!local \
    comment="transit is stateless; router-destined traffic stays tracked"
/ip/settings set rp-filter=loose

# --- per-WAN routing table -------------------------------------------
# Declared before the WAN, because a dhcp-client below names this table in
# default-route-tables and RouterOS resolves that name at add time.
#
# ONE WAN AND STILL A SEPARATE TABLE. This isn't ceremony: the site's egress
# default is the iBGP one from the BRs, which points INTO a tunnel. If the
# WAN's own default landed in `main` it would either fight that or, worse, be
# the route the tunnels' own outer packets resolve through. Everything the WAN
# knows stays in via-{{ wan.id }}, and only marked packets go there.
/routing/table
add name=via-{{ wan.id }} fib

# --- WAN on {{ wan.interface }} ---------------------------------------------------
# Purge any factory dhcp-client first. Same reasoning as the ERs. A reset can
# leave one with add-default-route=yes distance=1, which beats the iBGP default
# from the BRs (200) and quietly steals every bit of the site's egress out the
# local ISP, where packets sourced from {{ r.delegation }} die at the ISP's
# BCP38 filter.
/ip/dhcp-client remove [find interface={{ wan.interface }}]
{% if wan.address is defined %}
/ip/address remove [find interface={{ wan.interface }}]
/ip/address add address={{ wan.address }} interface={{ wan.interface }} comment="{{ wan.id }}"
{% else %}
# default-route-tables puts the lease's default straight into via-{{ wan.id }} and
# lets the client own its lifecycle. Nothing lands in main.
/ip/dhcp-client add interface={{ wan.interface }} default-route-tables=via-{{ wan.id }} \
    use-peer-dns=no use-peer-ntp=no comment="{{ wan.id }}"
{% endif %}

# --- WireGuard: one interface per BR ----------------------------------
# This end always initiates (endpoint + keepalive), because a site sits behind
# whatever the local ISP hands out. Possibly CGNAT, certainly not a stable
# inbound port. The BR side carries no endpoint and waits to be called.
#
# The BR listens on 520xx for site tunnels ({{ r.tunnels | map(attribute='endpoint_port') | unique | sort | join(', ') }} here. The port
# encodes the SITE, so every BR uses the same one for this site), a class of its
# own alongside 518xx/519xx for the ER WANs. That range is what the mangle mark
# and the srcnat below match on; it's derived once in generate.py and must
# never be restated by hand.
/interface/wireguard
{% for x in r.tunnels %}
add name={{ x.iface }} listen-port={{ x.listen_port }} mtu={{ t.wg_mtu }} private-key="{{ x.private }}"
{% endfor %}

/interface/wireguard/peers
{% for x in r.tunnels %}
add interface={{ x.iface }} public-key="{{ x.peer_public }}" preshared-key="{{ x.psk }}" endpoint-address={{ x.endpoint }} endpoint-port={{ x.endpoint_port }} allowed-address={{ '0.0.0.0/0,::/0' if d.v6 else '0.0.0.0/0' }} persistent-keepalive=25s name="{{ x.peer_name }}"
{% endfor %}

/ip/address
{% for x in r.tunnels %}
add address={{ x.address }} interface={{ x.iface }}
{% endfor %}
{% if d.v6 %}
# ::/0 in allowed-address is mandatory. See the note in br.rsc.j2. Without it
# the tunnel comes up, v4 is perfect, and v6 vanishes inside WireGuard silently.
/ipv6/address
{% for x in r.tunnels %}
add address={{ x.address6 }} interface={{ x.iface }} advertise=no
{% endfor %}
{% endif %}

/interface/list
add name=tun-site
add name=tunnels include=tun-site
/interface/list/member
{% for x in r.tunnels %}
add list=tun-{{ x.link_class }} interface={{ x.iface }}
{% endfor %}

# --- the site LAN -----------------------------------------------------
# A reset with no-defaults=yes leaves a hAP-class device with NO bridge at all,
# so this builds one. RSTP is left at the RouterOS default rather than being
# turned off the way lo0 turns it off: this is a real L2 domain with sockets
# a human can plug a cable into, and a loop here would otherwise be silent.
#
# WIRELESS IS DELIBERATELY NOT TOUCHED. After a no-defaults reset the radios
# are disabled with no SSID, so they broadcast nothing; configuring them from
# here would put a PSK in a generated file. Bring them up by hand and add them
# to this bridge if you want them, and check they are still down otherwise:
#     /interface/wireless print     (or /interface/wifi print on 7.13+)
/interface/bridge add name=br-lan
/interface/bridge/port
{% for i in r.lan_interfaces %}
add bridge=br-lan interface={{ i }}
{% endfor %}

/ip/address
add address={{ r.lan_gateway }}/{{ r.delegation.split('/')[1] }} interface=br-lan comment="site LAN -- inside default gateway"
{% if d.v6 %}
/ipv6/address
# advertise=yes, and this is the ONLY interface in the fleet where that's
# true. Everywhere else (loopbacks, tunnels, the hdc transit segment) an RA
# would be an offer of a default gateway to something that must not take it.
# Here it's the point: inside devices SLAAC out of {{ r.lan_net6 }} and learn
# this router as their default. Verify the ND profile actually exists after a
# no-defaults reset:  /ipv6/nd print
add address={{ r.lan_gateway6 }}/64 interface=br-lan advertise=yes comment="site LAN"
# ...and this router accepts NONE. A forwarding router ignores RAs by default;
# state it, because the setting is global and the WAN is a segment we don't
# control. The site's v6 default comes from the BRs over iBGP, never from the
# local ISP.
/ipv6/settings set accept-router-advertisements=no
{% endif %}

# --- pin the tunnels' OUTER packets to the WAN ------------------------
# chain=output only; the transit fast path is never touched. Without this the
# outer packets resolve through the iBGP default and try to reach a BR public
# through a tunnel to that same BR. That isn't a slow path, it's a permanent
# handshake failure.
/ip/firewall/mangle
add chain=output action=mark-routing new-routing-mark=via-{{ wan.id }} passthrough=no \
    protocol=udp dst-port={{ wan.wg_ports }} comment="WG outer -> {{ wan.id }}"

# --- and make the SOURCE ADDRESS agree with the WAN the mark chose ----
# THE MARK ALONE IS NOT ENOUGH. RouterOS assigns the source address at the
# routing decision that happens BEFORE mangle output, out of `main`; the mark is
# honoured later, at Routing Adjustment, which re-picks the route and NOT the
# source. So a marked packet leaves {{ wan.interface }} carrying whatever address main
# would have chosen: on a DHCP WAN with no /32 pins, a tunnel address.
#
# srcnat runs after Routing Adjustment and is the first place that can see the
# real egress interface. masquerade rather than src-nat to-address= because a
# DHCP WAN has no address to hard-code. See AD-LOG §23: this cost a day on er1,
# and every symptom pointed at the carrier.
#
# Safe on a router doing stateless transit: the match is udp + this one port
# range + this one interface, and the transit path is notrack'd above. An
# untracked packet can't be NATted at all.
/ip/firewall/nat
add chain=srcnat action=masquerade out-interface={{ wan.interface }} protocol=udp \
    dst-port={{ wan.wg_ports }} comment="WG outer -> {{ wan.id }}: src must match egress"

# NO masquerade for the site LAN, deliberately. {{ r.delegation }} is ours and is
# announced by this AS, so it egresses at a BR as itself. NATting it here would
# throw away the entire reason a site gets public space.

{% if wan.gateway is defined %}
/ip/route
add dst-address=0.0.0.0/0 gateway={{ wan.gateway }} routing-table=via-{{ wan.id }}
# main-table /32s: the management path to the BR publics, and a safe landing
# spot for any WG packet that escapes the mark (otherwise it recurses into a
# tunnel).
{% for br in d.brs %}
add dst-address={{ br.wan_address }}/32 gateway={{ wan.gateway }} distance=1 comment="{{ br.name }} via {{ wan.id }}"
{% endfor %}
{% else %}
# No /32 pins to the BR publics: {{ wan.id }} is a dhcp-client, so there's no
# gateway address to write down at build time. The mangle mark above is what
# keeps the outer packets out of the tunnels, and the masquerade is what makes
# their source address survive it. Both are REQUIRED here in a way they
# aren't on a static WAN. Don't "simplify" either away.
{% endif %}

# --- what this site advertises: its attached /29 ----------------------
# There's no blackhole anchor in v4 and that's the design, not an omission.
# The /29 IS the LAN, so the CONNECTED route is the origination gate: LAN down
# -> no connected route -> output.network stops advertising -> the BRs stop
# counting this site as a live customer. The ERs need an anchor because their
# /25 is attached to nothing; adding one here would only defeat the gate.
# (network-blackhole=no on the templates below is what stops RouterOS inventing
# its own blackhole and making that true by accident.)
/ip/firewall/address-list
add list=advertise address={{ r.delegation }} comment="site customer block"

/ip/route
# LOOP GUARD for the whole /24. Never advertised (ibgp-out rejects it).
add dst-address={{ t.prefix }} blackhole distance=254 comment="loop guard"
{% if d.v6 %}

/ipv6/firewall/address-list
add list=advertise6 address={{ r.delegation6 }} comment="site /48"
/ipv6/route
# The v6 side DOES get an anchor, and the asymmetry with v4 above is real. In
# v4 the delegation is the LAN. In v6 the site holds a whole /48 of which the
# LAN is one /64, so no connected route covers what we originate. The anchor
# is what output.network=advertise6 matches on, exactly like the ERs'
# home-anchor. It also catches traffic to the parts of the /48 that don't
# exist yet instead of letting it loop.
#
# The cost: v6 origination is gated on this ROUTER being alive, not on the LAN
# being up, where v4 is gated on both. A site whose LAN is dead keeps
# announcing its /48 and blackholes it here rather than at the BR. Same drop,
# different place: but it does mean the BRs' anchor-guard would count this
# site as "delivering" v6 when it's not. Know that before that guard is ever
# armed.
add dst-address={{ r.delegation6 }} blackhole distance=254 comment="site-anchor6"
add dst-address={{ t.aggregate_v6 }} blackhole distance=254 comment="loop guard v6"
{% endif %}

{% if t.bfd.configure %}
# --- BFD: the fast liveness detector, UNDER OSPF ----------------------
# A config entry here does NOT start anything. It only permits a session on
# these interfaces and sets the timers. Sessions are created when a protocol
# asks (use-bfd on the OSPF templates below).
#
# THE DEFAULT IS DENY: RouterOS forbids BFD on every interface not listed here,
# so the br-lan forbid rule is redundant TODAY. It's here because br-lan is the
# one segment on this box with untrusted devices on it. Clients, not routers.
# A future broad allow-rule would silently include them; this one doesn't.
# Entries are order-sensitive (first match wins), so the deny leads.
/routing/bfd/configuration
add interfaces=br-lan forbid-bfd=yes comment="site LAN: never"
{% set b = t.bfd.links.site %}
add interfaces=tun-site min-tx={{ b.interval }} min-rx={{ b.interval }} multiplier={{ b.multiplier }} comment="site: detect ~{{ b.detect_ms }}ms"

{% endif %}
# --- OSPF -------------------------------------------------------------
# WG interfaces never go down on their own. OSPF hellos{% if t.bfd.use_ospf %} (and BFD underneath){% endif %} are the
# only liveness detector on these tunnels.
#
# br-lan is PASSIVE: the site LAN goes into the LSDB so the rest of the AS can
# reach it, but this router will never form an adjacency with something a
# client plugged in. Same treatment the ERs give their firewall transit.
/routing/ospf/instance add name=core version=2 router-id={{ r.loopback }}
/routing/ospf/area add name=bb instance=core area-id=0.0.0.0
/routing/ospf/interface-template
add area=bb interfaces=lo0 passive
add area=bb interfaces=br-lan passive comment="site LAN"
add area=bb interfaces=tun-site type=ptp cost={{ t.ospf_cost.site }} hello-interval=5s dead-interval=20s{{ bfd_on }}
{% if d.v6 %}

# --- OSPFv3: separate instance, v4 router-id, identical costs ---------
# Same reasoning as everywhere else: an OSPFv3 router-id is still 32-bit, and
# costs that differ between the families would move one and not the other on a
# single link failure.
/routing/ospf/instance add name=core6 version=3 router-id={{ r.loopback }}
/routing/ospf/area add name=bb6 instance=core6 area-id=0.0.0.0
/routing/ospf/interface-template
add area=bb6 interfaces=lo0 passive
add area=bb6 interfaces=br-lan passive comment="site LAN"
add area=bb6 interfaces=tun-site type=ptp cost={{ t.ospf_cost.site }} hello-interval=5s dead-interval=20s{{ bfd_on }}
{% endif %}

# --- BGP instance: router-id lives HERE, not on templates/connections.
#
# multipath is BGP ECMP, a COUNT of routes to install (type `num`). Not a
# switch; `multipath=yes` aborts the import. With a tunnel to EVERY BR and no
# primary (AD-LOG 24.1), a site holds one identical default per BR at the same
# IGP metric. Without it a router-id tie-break picks one; with it they are all
# installed, and te.local_pref collapses them to the preferred BR when set.
/routing/bgp/instance
add name=core as={{ t.asn }} router-id={{ r.loopback }}{% if t.bgp_multipath %} multipath={{ t.bgp_multipath }}{% endif %}


# A connection with no templates= inherits `default`. Keep it bare.
/routing/bgp/template set default output.filter-chain="" output.network=""

# --- iBGP: FULL MESH. This site originates its own delegation, so
# force-self is right. ONE output chain, unlike the ERs: a site has no
# customer more-specifics to hide from anybody, so every peer (BR, ER or
# another site) gets exactly the same thing.
/routing/bgp/template
add name=ibgp afi=ip multihop=yes nexthop-choice=force-self \
    output.network=advertise \
    output.network-blackhole=no \
    output.filter-chain=ibgp-out

/routing/bgp/connection
{% for p in r.ibgp_peers %}
add name=ibgp-{{ p.name }} instance=core templates=ibgp \
    local.address={{ r.loopback }} local.role=ibgp \
    remote.address={{ p.loopback }} remote.as={{ t.asn }} \
    input.filter={{ p.ibgp_in_chain }}
{% endfor %}

/routing/filter/rule
add chain=ibgp-in rule="accept"
{% if d.ibgp_in_lps %}
# EGRESS TE: the same per-BR local-pref the ERs apply, for the same reason.
# A site egresses through a BR exactly as an ER does. Kept in step with
# er.rsc.j2 deliberately; a site that quietly missed the policy would leave
# through a BR the rest of the AS is steering away from.
# See docs/traffic-engineering.md.
{% for lp in d.ibgp_in_lps %}
add chain=ibgp-in-lp{{ lp }} rule="if (dst==0.0.0.0/0 && dst-len==0) { set bgp-local-pref {{ lp }}; accept }"
add chain=ibgp-in-lp{{ lp }} rule="accept"
{% endfor %}
{% endif %}
# NEVER leak the aggregate: the BRs originate it locally, and a /24 from here
# would send in-block traffic to a site that can only drop it.
add chain=ibgp-out rule="if (dst=={{ t.prefix }} && dst-len=={{ t.prefix.split('/')[1] }}) { reject }"
# RTBH stays EXPLICIT here as everywhere: a /32 is a blackhole request only when
# it's on the `rtbh` address-list. Length alone means nothing. See AD-LOG 9.3.
add chain=ibgp-out rule="if (dst in {{ t.prefix }} && dst-len==32 && dst in rtbh) { set bgp-large-communities {{ t.asn }}:1:666; accept }"
add chain=ibgp-out rule="accept"
{% if d.v6 %}

# --- iBGP v6: separate sessions, same shape --------------------------
/routing/bgp/template
add name=ibgp6 afi=ipv6 multihop=yes nexthop-choice=force-self \
    output.network=advertise6 \
    output.network-blackhole=no \
    output.filter-chain=ibgp6-out

/routing/bgp/connection
{% for p in r.ibgp_peers %}
add name=ibgp6-{{ p.name }} instance=core templates=ibgp6 \
    local.address={{ r.loopback6 }} local.role=ibgp \
    remote.address={{ p.loopback6 }} remote.as={{ t.asn }} \
    input.filter={{ p.ibgp6_in_chain }}
{% endfor %}

/routing/filter/rule
add chain=ibgp6-in rule="accept"
{% if d.ibgp_in_lps %}
{% for lp in d.ibgp_in_lps %}
add chain=ibgp6-in-lp{{ lp }} rule="if (dst==::/0 && dst-len==0) { set bgp-local-pref {{ lp }}; accept }"
add chain=ibgp6-in-lp{{ lp }} rule="accept"
{% endfor %}
{% endif %}
add chain=ibgp6-out rule="if (dst=={{ t.aggregate_v6 }} && dst-len=={{ t.aggregate_v6.split('/')[1] }}) { reject }"
add chain=ibgp6-out rule="if (dst in {{ t.aggregate_v6 }} && dst-len==128 && dst in rtbh6) { set bgp-large-communities {{ t.asn }}:1:666; accept }"
add chain=ibgp6-out rule="accept"
{% endif %}

# --- MSS clamp. The one thing allowed in the forward chain. -----------
/ip/firewall/mangle
add chain=forward action=change-mss new-mss={{ t.mss_clamp }} passthrough=yes \
    protocol=tcp tcp-flags=syn tcp-mss={{ t.mss_clamp + 1 }}-65535 out-interface-list=tunnels
add chain=forward action=change-mss new-mss={{ t.mss_clamp }} passthrough=yes \
    protocol=tcp tcp-flags=syn tcp-mss={{ t.mss_clamp + 1 }}-65535 in-interface-list=tunnels

# --- input -----------------------------------------------------------
# TERMINAL DROP, and the shape is the BR's rather than the ER's. An ER drops
# only on its WANs and trusts everything else, because everything else at hdc is
# infrastructure or a customer firewall. Here the LAN has ordinary client
# devices on it, so nothing is trusted by interface: the tunnels are accepted
# because they are WireGuard-authenticated, mgmt is accepted because it's the
# way back in, and the rest (WAN and LAN alike) is dropped.
#
{% if r.mgmt_overlap %}
# >>> IT DOES NOT SHUT THIS LAN OUT, AND THAT IS NOT A BUG IN THIS CHAIN.
# >>> `accept src-address-list=mgmt` sits ABOVE the drop, so anything on that
# >>> list is accepted whatever interface it arrived on. And {{ r.delegation }},
# >>> this site's CLIENT LAN, is inside {{ r.mgmt_overlap | join(' and ') }}.
# >>>
# >>> So a device anyone plugs into {{ r.lan_interfaces | join('/') }} is a management source for
# >>> this router AND, over the tunnels, for every other router in the AS.
# >>> That's a property of the mgmt list, not of this file: narrow
# >>> mgmt_prefixes / mgmt_prefixes_url to the addresses you actually manage
# >>> from. Nothing here can undo it, because the accept is the way back in.
{% endif %}
{% if not r.mgmt_overlap %}
#
# What that costs: someone standing at the site can't SSH this router from the
# LAN. They couldn't anyway (/ip/service binds ssh and winbox to the same
# mgmt list) and the fix is NOT to add {{ r.delegation }} to it, because that
# list is fleet-wide: it would hand every device on this LAN a path to every
# router in the AS. Use the console.
{% endif %}
#
# ICMP is accepted globally, so pinging this gateway from the LAN still works.
/ip/firewall/filter
add chain=input action=accept connection-state=established,related
add chain=input action=accept protocol=icmp comment="PMTUD/QUIC - never break this"
add chain=input action=accept in-interface-list=tunnels comment="WG-authenticated"
{% if t.snmp is defined and t.snmp and t.snmp.enabled %}
# SNMPv3 polling. A site is polled over its tunnels (already accepted above),
# so this rule matters on the day the tunnels are the thing being diagnosed
# and the poller has some other way in. udp/161 only.
add chain=input action=accept protocol=udp dst-port=161 src-address-list=snmp comment="SNMPv3 poller"
{% endif %}
add chain=input action=accept src-address-list=mgmt
add chain=input action=drop
{% if d.v6 %}

# --- input v6 ---------------------------------------------------------
/ipv6/firewall/filter
add chain=input action=accept connection-state=established,related
# ICMPv6 carries Neighbour Discovery, and this router is the LAN's default
# gateway: drop it and {{ r.lan_net6 }} stops resolving entirely. It also
# carries the Router Solicitations that make advertise=yes above work. Never
# narrow this to echo.
add chain=input action=accept protocol=icmpv6 comment="ND + RS/RA + PMTUD - never break this"
add chain=input action=accept in-interface-list=tunnels comment="WG-authenticated"
add chain=input action=drop

# MSS clamp for v6. {{ t.mss_clamp_v6 }}, NOT the v4 {{ t.mss_clamp }}: same {{ t.wg_mtu }} tunnel, but the
# IPv6 header is 40 bytes where IPv4's is 20, and v6 has no router-side
# fragmentation to fall back on when the clamp is wrong.
/ipv6/firewall/mangle
add chain=forward action=change-mss new-mss={{ t.mss_clamp_v6 }} passthrough=yes \
    protocol=tcp tcp-flags=syn tcp-mss={{ t.mss_clamp_v6 + 1 }}-65535 out-interface-list=tunnels
add chain=forward action=change-mss new-mss={{ t.mss_clamp_v6 }} passthrough=yes \
    protocol=tcp tcp-flags=syn tcp-mss={{ t.mss_clamp_v6 + 1 }}-65535 in-interface-list=tunnels
{% endif %}

{% include '_snmp.j2' %}
