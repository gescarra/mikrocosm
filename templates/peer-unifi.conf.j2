! =====================================================================
!  {{ fw.name }} -- UniFi gateway BGP configuration, FRR format
!
!  customer AS{{ fw.asn }}  <->  AS{{ p.peer_asn }}  ({{ p.neighbors | map(attribute='name') | join(' + ') }})
!
!  GENERATED by generate.py from topology.yml. DO NOT HAND-EDIT.
!
!  This is the CUSTOMER half of eBGP sessions the ERs already run, built from
!  the SAME grant their inbound filters enforce -- so the two ends cannot
!  drift. The ER's `cust-in-{{ fw.name }}` chain, not this file, is the security
!  boundary: anything added here outside the grant is rejected there, and a
!  prefix rejected at the ER never enters AS{{ t.asn }} at all. To change what
!  {{ fw.name }} may advertise, edit `firewalls:` in topology.yml and rebuild BOTH ends.
!
!  UPLOAD:  UniFi Network -> Settings -> Routing -> BGP -> upload this file.
!           UniFi OS 4.1.13+ (UDM/UCG/EFG/UDW) or UXG-Enterprise 4.1.8+.
!
!  NOT IN THIS FILE, and the session does not come up without it: a UniFi
!  firewall policy permitting TCP/179 TO THE GATEWAY ITSELF from the transit
!  segment {{ t.home.transit_net }}. UniFi drops traffic addressed to the gateway by
!  default, so create a <transit zone> -> Gateway policy allowing the BGP
!  service. (Ubiquiti's own article makes the same point for an ISP session,
!  where the zone is External rather than an internal one.)
!
! ---------------------------------------------------------------------
!  WHAT THIS SIDE DOES
!
!  sends:
{% for s in p.summary %}
!      {{ s }}
{% endfor %}
!
{% if p.accept_default %}
!  receives:  the default route, and nothing else. The ERs' `cust-out` chain
!             accepts {{ p.default_desc }} and rejects everything else, so no
!             internal prefix can ever leak to a customer. The inbound
!             prefix-list below mirrors that instead of trusting it.
{% else %}
!  receives:  NOTHING (default_route: ignore). The ERs still offer
!             {{ p.default_desc }}; it is refused inbound so it never enters the
!             routing table. This gateway's default belongs to its own WAN
!             manager, with the transit configured as one more WAN (gateway
!             {{ p.neighbors[0].address }}) alongside the others -- otherwise FRR's
!             default lands in the kernel ahead of the per-WAN routes and every
!             other WAN goes idle the moment the session comes up.
!             `show bgp neighbors <er> received-routes` still shows what the
!             ERs offer (soft-reconfiguration inbound keeps a copy).
{% endif %}
{% if p.ecmp %}
!
!  egress:    `maximum-paths {{ p.ecmp }}`. Both ERs advertise the default with identical
!             attributes, and FRR installs exactly ONE path without that line
!             -- which would quietly pin all outbound traffic to whichever ER
!             won the tie-break, on a segment built for ECMP. An ER that loses
!             its own upstream stops originating the default (the ERs run
!             `default-originate=if-installed`), so it drops out of the set on
!             its own.
{% endif %}
!
!  {{ 'THREE' if p.ecmp else 'TWO' }} DEVIATIONS from the example in Ubiquiti's article, all deliberate:
!    - `no bgp default ipv4-unicast`, so the IPv6 neighbours are not also
!      dragged into the IPv4 family. Every neighbour is activated explicitly.
!    - `network` statements live inside their address-family rather than at
!      the top. Required for IPv6, so both families read the same way.
{% if p.ecmp %}
!    - `maximum-paths`, which the single-homed ISP example has no use for.
{% endif %}
!  If a firmware ever rejects one of these, it is a line to drop, not a
!  rebuild: the session and the policy do not depend on any of them.
!
!  AND ONE THING DELIBERATELY ABSENT: no `neighbor <ip> local-role ...`. The
!  ERs carry `local.role=ebgp-customer` on their end, which is an RFC 9234
!  role, and RFC 9234 requires the two ends to be COMPLEMENTARY -- get the
!  pairing backwards and the session is refused outright with a Role Mismatch,
!  not merely filtered. Sending no role capability at all is the case the RFC
!  handles by skipping the check, so it is the one that cannot be wrong here.
!  Add a role only if you are also changing the ER end in the same rebuild.
! =====================================================================

router bgp {{ fw.asn }}
bgp router-id {{ p.router_id }}
bgp log-neighbor-changes
no bgp default ipv4-unicast
!
{% for n in p.neighbors %}
neighbor {{ n.address }} remote-as {{ p.peer_asn }}
neighbor {{ n.address }} description {{ n.name }}
{% endfor %}
{% if p.v6 %}
!
{% for n in p.neighbors %}
neighbor {{ n.address6 }} remote-as {{ p.peer_asn }}
neighbor {{ n.address6 }} description {{ n.name }} v6
{% endfor %}
{% endif %}
!
address-family ipv4 unicast
{% if p.networks %}
! Originated prefixes. FRR only advertises a `network` it can already resolve
! in its OWN table, so each address here has to exist on this gateway -- an
! interface address, a VIP, or a static route. A `network` for an address that
! is not present is silently not advertised and the ER never sees it, which
! looks exactly like a filter problem. `show ip bgp` here is where you check.
{% for c in p.networks %}
network {{ c.prefix.split('/')[0] }} mask {{ c.netmask }}
{% endfor %}
{% endif %}
{% if p.blocks %}
! Delegated. Nothing to enumerate -- the point of a delegation is that this
! gateway carves it up without a change at the ER -- so LANs out of the block
! are picked up as connected routes and filtered down to the grant by
! {{ p.rm_out }}. Adding one is then a UniFi network, not an edit here, and the
! route-map is what keeps every OTHER connected network (the transit segment,
! any private LAN) out of BGP.
!   {{ p.blocks | map(attribute='prefix') | join(', ') }}
redistribute connected route-map {{ p.rm_out }}
{% endif %}
{% if p.ecmp %}
maximum-paths {{ p.ecmp }}
{% endif %}
{% for n in p.neighbors %}
neighbor {{ n.address }} activate
neighbor {{ n.address }} soft-reconfiguration inbound
neighbor {{ n.address }} route-map {{ p.rm_in }} in
neighbor {{ n.address }} route-map {{ p.rm_out }} out
{% endfor %}
exit-address-family
{% if p.v6 %}
!
address-family ipv6 unicast
{% if p.networks6 %}
{% for c in p.networks6 %}
network {{ c.prefix }}
{% endfor %}
{% endif %}
{% if p.blocks6 %}
! Delegated, same shape as v4 above: the /64 LANs carved out of the block are
! connected routes, and {{ p.rm_out6 }} is what stops every OTHER connected
! network riding out with them.
!   {{ p.blocks6 | map(attribute='prefix') | join(', ') }}
redistribute connected route-map {{ p.rm_out6 }}
{% endif %}
{% if p.ecmp %}
maximum-paths {{ p.ecmp }}
{% endif %}
{% for n in p.neighbors %}
neighbor {{ n.address6 }} activate
neighbor {{ n.address6 }} soft-reconfiguration inbound
neighbor {{ n.address6 }} route-map {{ p.rm_in6 }} in
neighbor {{ n.address6 }} route-map {{ p.rm_out6 }} out
{% endfor %}
exit-address-family
{% endif %}
!
exit
!
! =====================================================================
!  Policy. Ubiquiti requires prefix-lists and route-maps to come AFTER the
!  router bgp section, at the bottom of the file. Both directions are
!  explicitly policed on every neighbour, which is also what satisfies FRR's
!  `bgp ebgp-requires-policy` default -- an eBGP session with no in/out policy
!  exchanges nothing and says so only in the log.
! =====================================================================
route-map {{ p.rm_in }} permit 10
match ip address prefix-list {{ p.pl_in }}
exit
!
route-map {{ p.rm_out }} permit 10
match ip address prefix-list {{ p.pl_out }}
exit
{% if p.v6 %}
!
route-map {{ p.rm_in6 }} permit 10
match ipv6 address prefix-list {{ p.pl_in6 }}
exit
!
route-map {{ p.rm_out6 }} permit 10
match ipv6 address prefix-list {{ p.pl_out6 }}
exit
{% endif %}
!
{% if p.accept_default %}
! IN: the default, exactly. No `le`, so this matches 0.0.0.0/0 itself and
! nothing more-specific. An ER is not supposed to send anything else; this is
! where that stops being a matter of trust.
ip prefix-list {{ p.pl_in }} seq 5 permit 0.0.0.0/0
{% else %}
! IN: nothing. default_route: ignore -- the WAN manager owns the default.
ip prefix-list {{ p.pl_in }} seq 5 deny any
{% endif %}
!
! OUT: the grant, and only the grant. Every line here is the mirror of a rule
! in the ER's `cust-in-{{ fw.name }}` chain: an exact VIP is one prefix at one
! length, a delegation is the block plus `le <max_len>`.
{% if p.claims %}
{% for c in p.claims %}
ip prefix-list {{ p.pl_out }} seq {{ loop.index * 5 }} permit {{ c.prefix }}{{ ' le %d' | format(c.max_len) if not c.exact else '' }}
{% endfor %}
{% else %}
! No IPv4 grant. Deny everything rather than leave the list undefined: an
! undefined prefix-list is a silent deny in FRR, and a silent deny is
! indistinguishable from a typo.
ip prefix-list {{ p.pl_out }} seq 5 deny any
{% endif %}
{% if p.v6 %}
!
ipv6 prefix-list {{ p.pl_in6 }} seq 5 {{ 'permit ::/0' if p.accept_default else 'deny any' }}
!
{% if p.claims6 %}
{% for c in p.claims6 %}
ipv6 prefix-list {{ p.pl_out6 }} seq {{ loop.index * 5 }} permit {{ c.prefix }}{{ ' le %d' | format(c.max_len) if not c.exact else '' }}
{% endfor %}
{% else %}
ipv6 prefix-list {{ p.pl_out6 }} seq 5 deny any
{% endif %}
{% endif %}
